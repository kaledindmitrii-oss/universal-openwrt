# Universal OpenWrt v30 - optimized adaptive OpenWrt manager
#!/bin/sh
# Universal OpenWrt v30.2.15
# Capability-driven wrapper for the open-routerich backend.
# Safe defaults: detect -> backup -> compatibility plan -> install -> health-check.
# Does not blindly install kernel modules or overwrite unknown UCI sections.

set -u
VERSION='30.2.16'
BASE='/tmp/universal-openwrt'
BACKUP_BASE='/root/universal-openwrt-backups'
LOG='/root/universal-openwrt.log'
BACKEND_URL="${UOW_BACKEND_URL:-}"
BACKEND_SHA256="${UOW_BACKEND_SHA256:-}"
MODE='plan'
DRY=0
ASSUME_YES=0
PROFILE='auto'
MODULE='auto'
TUNNEL_NAME=''
TUNNEL_ADDRESS=''
TUNNEL_PORT='443'
TUNNEL_UUID=''
TUNNEL_SERVERNAME=''
SPEED='standard'
VPN_MODE='split'
RESOURCE_CACHE_TTL=600

mkdir -p "$BASE" 2>/dev/null || true
UOWRT_LIB='/usr/lib/universal-openwrt'
SCRIPT_LIB_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../modules" 2>/dev/null && pwd || true)"
for _uowrt_lib in "$SCRIPT_LIB_DIR/strategy-engine.sh" "$SCRIPT_LIB_DIR/tunnel-engine.sh"; do
  [ -f "$_uowrt_lib" ] && . "$_uowrt_lib"
done
if [ ! -f "$SCRIPT_LIB_DIR/strategy-engine.sh" ]; then
  [ -f "$UOWRT_LIB/strategy-engine.sh" ] && . "$UOWRT_LIB/strategy-engine.sh"
fi
if [ ! -f "$SCRIPT_LIB_DIR/tunnel-engine.sh" ]; then
  [ -f "$UOWRT_LIB/tunnel-engine.sh" ] && . "$UOWRT_LIB/tunnel-engine.sh"
fi
touch "$LOG" 2>/dev/null || LOG="$BASE/run.log"

modules_self_check(){
  local missing=0 f
  for f in strategy-engine.sh tunnel-engine.sh tg-ws-proxy.sh; do
    if [ ! -f "$UOWRT_LIB/$f" ] && [ ! -f "$SCRIPT_LIB_DIR/$f" ]; then
      log "ERROR: runtime module missing: $f"
      missing=1
    fi
  done
  return "$missing"
}

# Keep /tmp footprint bounded; preserve cached OONI data and latest reports.
cleanup_tmp(){
  find "$BASE" -type f -name '*.out' -size +512k -delete 2>/dev/null || true
}
trap cleanup_tmp EXIT

log(){ printf '[%s] %s\n' "$(date '+%F %T' 2>/dev/null || echo now)" "$*" | tee -a "$LOG"; }
die(){ log "ERROR: $*"; exit 1; }
have(){ command -v "$1" >/dev/null 2>&1; }
run(){ log "+ $*"; [ "$DRY" = 1 ] && return 0; "$@"; }

get_uci(){ uci -q get "$1" 2>/dev/null || true; }

# ---------- detection ----------
detect(){
  MODEL='unknown'; BOARD='unknown'; VERSION_OW='unknown'; TARGET='unknown'; ARCH='unknown'
  [ -r /etc/openwrt_release ] && . /etc/openwrt_release
  if have ubus && have jsonfilter; then
    J="$(ubus call system board 2>/dev/null || true)"
    MODEL="$(printf '%s' "$J" | jsonfilter -e '@.model' 2>/dev/null || true)"
    BOARD="$(printf '%s' "$J" | jsonfilter -e '@.board_name' 2>/dev/null || true)"
    VERSION_OW="$(printf '%s' "$J" | jsonfilter -e '@.release.version' 2>/dev/null || true)"
    TARGET="$(printf '%s' "$J" | jsonfilter -e '@.release.target' 2>/dev/null || true)"
    ARCH="$(printf '%s' "$J" | jsonfilter -e '@.release.arch' 2>/dev/null || true)"
  fi
  MODEL="${MODEL:-${DISTRIB_MODEL:-unknown}}"
  BOARD="${BOARD:-${OPENWRT_BOARD:-unknown}}"
  VERSION_OW="${VERSION_OW:-${DISTRIB_RELEASE:-unknown}}"
  TARGET="${TARGET:-${DISTRIB_TARGET:-unknown}}"
  ARCH="${ARCH:-${DISTRIB_ARCH:-$(uname -m 2>/dev/null || echo unknown)}}"
  KERNEL="$(uname -r 2>/dev/null || echo unknown)"
  if have apk; then PM=apk; elif have opkg; then PM=opkg; else PM=none; fi
  if have fw4; then FW=fw4; elif have nft; then FW=nft; else FW=unknown; fi
  if have nft; then NFT=1; else NFT=0; fi
  IPT=0
  EXPECTED_PM=unsupported
  case "$VERSION_OW" in
    24.10.*)
      _p="${VERSION_OW#24.10.}"
      case "$_p" in ''|*[!0-9]*) : ;; *)
        _p="$(printf '%s' "$_p" | sed 's/^0*//')"; _p="${_p:-0}"
        [ "$_p" -ge 2 ] 2>/dev/null && EXPECTED_PM=opkg
      ;; esac
      ;;
    25.12.*)
      _p="${VERSION_OW#25.12.}"
      case "$_p" in ''|*[!0-9]*) : ;; *) EXPECTED_PM=apk;; esac
      ;;
  esac
  if [ "$EXPECTED_PM" != unsupported ] && [ "$PM" = "$EXPECTED_PM" ] && [ "$FW" = fw4 ]; then SUPPORTED=1; else SUPPORTED=0; fi
  if have wg; then WG=1; else WG=0; fi
  if lsmod 2>/dev/null | grep -q '^amneziawg'; then AWG=1; else AWG=0; fi
  LAN_DEV="$(get_uci network.lan.device)"; LAN_DEV="${LAN_DEV:-$(get_uci network.lan.ifname)}"
  WAN_DEV="$(get_uci network.wan.device)"; WAN_DEV="${WAN_DEV:-$(get_uci network.wan.ifname)}"
  DEFAULT_IF="$(ip route 2>/dev/null | awk '/^default /{print $5; exit}')"
  DNSMASQ="$(uci show dhcp 2>/dev/null | sed -n 's/^dhcp\.\([^=]*\)=dnsmasq$/\1/p' | head -n1)"
  ROOT_FLAGS="$(awk '$2=="/"{print $4; exit}' /proc/mounts 2>/dev/null)"
  case "$ROOT_FLAGS" in *ro*) IMMUTABLE=1;; *) IMMUTABLE=0;; esac
  FREE_KB="$(df -k / 2>/dev/null | awk 'NR==2{print $4}')"
  RAM_KB="$(awk '/MemAvailable:/{print $2; exit}' /proc/meminfo 2>/dev/null)"
}

show(){
  log '========== Universal OpenWrt v30 =========='
  log "Model=$MODEL"
  log "Board=$BOARD"
  log "OpenWrt=$VERSION_OW"
  log "Target=$TARGET"
  log "Arch=$ARCH"
  log "Kernel=$KERNEL"
  log "PackageManager=$PM"
  log "Firewall=$FW"
  log "LAN=${LAN_DEV:-unknown} WAN=${WAN_DEV:-unknown} DEFAULT_IF=${DEFAULT_IF:-unknown}"
  log "dnsmasq=${DNSMASQ:-unknown}"
  log "WireGuard=$WG AmneziaWG=$AWG nft=$NFT fw4=$([ "$FW" = fw4 ] && echo 1 || echo 0)"
  log "ImmutableRoot=$IMMUTABLE FreeRootKB=${FREE_KB:-unknown} FreeRAMKB=${RAM_KB:-unknown}"
  log '==========================================='
}

require_supported_platform(){
  [ "${SUPPORTED:-0}" = 1 ] || die "Unsupported platform: OpenWrt=$VERSION_OW package_manager=$PM firewall=$FW. Supported targets are OpenWrt 24.10.2+ (opkg) and 25.12.x (apk), both with fw4/nftables."
}

# ---------- runtime safety ----------
validate_speed(){
  case "$SPEED" in quick|standard|deep|auto) ;; *) die "unknown speed: $SPEED";; esac
}

set_resolved_profile(){
  case "$PROFILE" in
    auto)
      if [ "$IMMUTABLE" = 1 ]; then PROFILE_RESOLVED=dns; else PROFILE_RESOLVED=full; fi
      ;;
    minimal|dns|full) PROFILE_RESOLVED="$PROFILE";;
    *) die "unknown profile: $PROFILE";;
  esac
}

module_exists(){
  [ -n "${ROOT:-}" ] && [ -f "$ROOT/modules/$1.sh" ]
}

wait_dns(){
  i=0
  while [ "$i" -lt 5 ]; do
    nslookup openwrt.org 127.0.0.1 >/dev/null 2>&1 && return 0
    sleep 1
    i=$((i+1))
  done
  return 1
}

# ---------- capability plan ----------
plan(){
  CAP_DOH=0; CAP_QUIC=0; CAP_DPI=0; CAP_MALW=0; CAP_AWG=0; CAP_PODKOP=0; CAP_PROXY=0
  [ "$PM" != none ] && [ -n "$DNSMASQ" ] && CAP_DOH=1
  [ "$FW" = fw4 ] && CAP_QUIC=1
  [ -n "${ROOT:-}" ] && [ -f "${ROOT}/modules/dpi-desync.sh" ] && CAP_DPI=1
  [ -n "${ROOT:-}" ] && [ -f "${ROOT}/modules/malw-hosts.sh" ] && CAP_MALW=1
  if [ -e /sys/module/amneziawg ] || have awg || have awg-quick; then CAP_AWG=1; fi
  [ "$PM" != none ] && [ "$FW" = fw4 ] && [ "$IMMUTABLE" = 0 ] && CAP_PODKOP=1
  [ "$PM" != none ] && [ "$IMMUTABLE" = 0 ] && CAP_PROXY=1
  log 'Capability plan (detected, not guessed):'
  log "  DoH/dnsmasq       : $CAP_DOH"
  log "  QUIC firewall     : $CAP_QUIC"
  log "  DPI module        : $CAP_DPI"
  log "  geo/DNS module    : $CAP_MALW"
  log "  AmneziaWG ready   : $CAP_AWG"
  log "  Podkop candidate  : $CAP_PODKOP"
  log "  Proxy candidate   : $CAP_PROXY"
  log 'Rule: a kernel module is never considered installable from CPU architecture alone.'
}

# ---------- adaptive runtime optimizer / resource-aware strategy engine ----------
measure_resources(){
  RAM_TOTAL_KB=0; RAM_FREE_KB=0; ROOT_FREE_KB=0
  if [ -r /proc/meminfo ]; then
    RAM_TOTAL_KB="$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    RAM_FREE_KB="$(awk '/^MemAvailable:/{print $2}' /proc/meminfo 2>/dev/null || awk '/^MemFree:/{print $2}' /proc/meminfo 2>/dev/null || echo 0)"
  fi
  ROOT_FREE_KB="$(df -Pk / 2>/dev/null | awk 'NR==2{print $4}' || echo 0)"
  case "$RAM_TOTAL_KB" in ''|*[!0-9]*) RAM_TOTAL_KB=0;; esac
  case "$RAM_FREE_KB" in ''|*[!0-9]*) RAM_FREE_KB=0;; esac
  case "$ROOT_FREE_KB" in ''|*[!0-9]*) ROOT_FREE_KB=0;; esac
}
probe_https(){
  URL="$1"
  if have curl; then curl -fL -sS -o /dev/null --connect-timeout 5 --max-time 12 "$URL" >/dev/null 2>&1; return $?; fi
  if have wget; then wget -q --spider --timeout=8 "$URL" >/dev/null 2>&1; return $?; fi
  return 127
}
probe_dns_name(){
  N="$1"
  if have nslookup; then nslookup "$N" 127.0.0.1 >/dev/null 2>&1 && return 0; fi
  if have ping; then ping -c 1 -W 2 "$N" >/dev/null 2>&1 && return 0; fi
  return 1
}
# Candidate resource probes are intentionally lightweight. They are used BEFORE
# strategy selection and again AFTER installation. A failed probe means the
# resource is currently unreachable; it is not treated as proof of DPI.
RESOURCE_FILE="$BASE/resource-probes.txt"
# ---------- automatic blocked/slow resource discovery ----------
OONI_TESTLIST='https://api.ooni.io/api/v1/test-list/urls'
CANDIDATE_FILE="$BASE/candidates.txt"
RESOURCE_RESULTS="$BASE/resource-results.tsv"
SEED_DOMAINS="youtube.com www.youtube.com telegram.org web.telegram.org discord.com www.discord.com reddit.com www.reddit.com instagram.com www.instagram.com facebook.com www.facebook.com x.com twitter.com t.me whatsapp.com signal.org github.com raw.githubusercontent.com google.com www.google.com wikipedia.org www.wikipedia.org archive.org twitch.tv www.twitch.tv spotify.com www.spotify.com soundcloud.com linkedin.com www.linkedin.com medium.com rutracker.org rutor.info"

extract_domains(){
  sed 's/[{},\[\]\\" ]/\n/g' | grep -E '^(https?://)?([A-Za-z0-9][A-Za-z0-9.-]*\.)+[A-Za-z]{2,}(/|$)' | sed -E 's#^https?://##; s#/.*##' | tr '[:upper:]' '[:lower:]' | sed 's/^www\.//' | sort -u
}

discover_candidates(){
  mkdir -p "$BASE"
  OUT="$CANDIDATE_FILE"
  if command -v resource_matrix_build_candidate >/dev/null 2>&1; then resource_matrix_build_candidate "$SPEED"; [ -s "$RESOURCE_DIR/active.lst" ] && cp -f "$RESOURCE_DIR/active.lst" "$OUT"; fi
  CACHE="$BASE/ooni-testlist.json"
  META="$BASE/ooni-cache.ts"
  if [ ! -s "$OUT" ]; then
    for d in $SEED_DOMAINS; do printf '%s\n' "$d" >> "$OUT"; done
  fi
  OONI_SOURCE=0; USE_CACHE=0
  # Quick mode intentionally avoids OONI/network discovery overhead.
  if [ "$SPEED" = deep ]; then
    if [ -s "$CACHE" ] && [ -s "$META" ]; then
      NOW="$(date +%s 2>/dev/null || echo 0)"; TS="$(cat "$META" 2>/dev/null || echo 0)"
      case "$TS" in ''|*[!0-9]*) TS=0;; esac
      [ $((NOW-TS)) -lt 86400 ] && USE_CACHE=1
    fi
    if [ "$USE_CACHE" = 0 ]; then
      rm -f "$CACHE" 2>/dev/null || true
      if have curl; then curl -fsSL --connect-timeout 4 --max-time 10 "$OONI_TESTLIST" -o "$CACHE.tmp" 2>/dev/null && mv "$CACHE.tmp" "$CACHE" || rm -f "$CACHE.tmp"; \
      elif have wget; then wget -q -T 4 -O "$CACHE.tmp" "$OONI_TESTLIST" 2>/dev/null && mv "$CACHE.tmp" "$CACHE" || rm -f "$CACHE.tmp"; fi
      [ -s "$CACHE" ] && date +%s > "$META" 2>/dev/null || true
    fi
    if [ -s "$CACHE" ]; then extract_domains < "$CACHE" | head -n 160 >> "$OUT" || true; OONI_SOURCE=1; fi
  fi
  MAX_CAND=12
  [ "$SPEED" = quick ] && MAX_CAND=6
  [ "$SPEED" = deep ] && MAX_CAND=40
  sort -u "$OUT" | head -n "$MAX_CAND" > "$OUT.tmp" && mv "$OUT.tmp" "$OUT"
  CANDIDATE_COUNT="$(wc -l < "$OUT" 2>/dev/null || echo 0)"
  log "Automatic resource discovery: speed=$SPEED candidates=$CANDIDATE_COUNT OONI=$OONI_SOURCE cache=$USE_CACHE"
}

http_probe_timing(){
  URL="$1"
  if have curl; then
    curl -fL -sS -o /dev/null --connect-timeout 3 --max-time 7 -w '%{http_code}|%{time_namelookup}|%{time_connect}|%{time_appconnect}|%{time_total}' "$URL" 2>/dev/null || printf '000|0|0|0|7'
    return 0
  fi
  if have wget; then
    START="$(date +%s 2>/dev/null || echo 0)"
    if wget -q --spider -T 5 "$URL" >/dev/null 2>&1; then END="$(date +%s 2>/dev/null || echo 0)"; printf '200|0|0|0|%s' "$((END-START))"; else END="$(date +%s 2>/dev/null || echo 0)"; printf '000|0|0|0|%s' "$((END-START))"; fi
    return 0
  fi
  printf '000|0|0|0|99'
}

measure_domain(){
  D="$1"; T="$(http_probe_timing "https://$D/")"; CODE="$(printf '%s' "$T" | cut -d'|' -f1)"; DNS_T="$(printf '%s' "$T" | cut -d'|' -f2)"; CONNECT_T="$(printf '%s' "$T" | cut -d'|' -f3)"; TOTAL_T="$(printf '%s' "$T" | cut -d'|' -f5)"; STATUS='OK'; REASON='reachable'
  case "$CODE" in 2*|3*) : ;; *) if probe_dns_name "$D"; then STATUS='HTTPS_FAIL'; REASON='dns_ok_https_fail'; else STATUS='BLOCKED_CANDIDATE'; REASON='dns_and_https_fail'; fi;; esac
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$D" "$STATUS" "$REASON" "$CODE" "$DNS_T" "$CONNECT_T" "$TOTAL_T" >> "$RESOURCE_RESULTS"
}

median_from_file(){ F="$1"; [ -s "$F" ] || { echo 0; return; }; sort -n "$F" | awk '{a[NR]=$1} END{if(NR==0){print 0}else if(NR%2){print a[(NR+1)/2]}else{print (a[NR/2]+a[NR/2+1])/2}}'; }

prepare_resource_suite(){
  discover_candidates
  : > "$BASELINE_TIMES"
  CONTROL_OK=0
  for d in openwrt.org cloudflare.com google.com; do
    T="$(http_probe_timing "https://$d/")"; C="$(printf '%s' "$T" | cut -d'|' -f1)"
    case "$C" in 2*|3*) CONTROL_OK=$((CONTROL_OK+1));; esac
    printf '%s\n' "$(printf '%s' "$T" | cut -d'|' -f5)" >> "$BASELINE_TIMES"
  done
  if [ "$CONTROL_OK" -eq 0 ]; then
    BASELINE_VALID=0; SLOW_THRESHOLD=12; log 'Control resources unavailable; classification is INCONCLUSIVE.'
  else
    BASELINE_VALID=1; MEDIAN="$(median_from_file "$BASELINE_TIMES")"; [ -n "$MEDIAN" ] || MEDIAN=0
    SLOW_THRESHOLD="$(awk -v m="$MEDIAN" 'BEGIN{t=m*3; if(t<2.5)t=2.5; if(t>8)t=8; printf "%.3f",t}')"
    log "Local latency baseline median=${MEDIAN}s slow-threshold=${SLOW_THRESHOLD}s"
  fi
  printf '%s\n' "$BASELINE_VALID" > "$BASE/baseline-valid"
  printf '%s\n' "$SLOW_THRESHOLD" > "$BASE/slow-threshold"
}

scan_resource_suite(){
  LABEL="$1"; MAX="${2:-40}"; FILTER="${3:-all}"
  : > "$RESOURCE_RESULTS"
  printf 'domain\tstatus\treason\thttp_code\tdns_s\tconnect_s\ttotal_s\n' > "$RESOURCE_RESULTS"
  COUNT=0
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    if [ "$FILTER" = problematic ] && [ -f "$BASE/last-problematic.txt" ] && ! grep -Fxq "$d" "$BASE/last-problematic.txt"; then continue; fi
    measure_domain "$d"
    COUNT=$((COUNT+1)); [ "$COUNT" -ge "$MAX" ] && break
  done < "$CANDIDATE_FILE"
  if [ "${BASELINE_VALID:-0}" = 1 ]; then
    awk -F '\t' -v OFS='\t' -v th="$SLOW_THRESHOLD" 'NR==1{print;next}{st=$2;rs=$3;if(st=="OK" && ($7+0)>=th){st="SLOW_CANDIDATE";rs="latency_above_local_baseline"} print $1,st,rs,$4,$5,$6,$7}' "$RESOURCE_RESULTS" > "$RESOURCE_RESULTS.tmp" && mv "$RESOURCE_RESULTS.tmp" "$RESOURCE_RESULTS"
  fi
  BLOCKED_COUNT="$(awk -F '\t' 'NR>1&&$2=="BLOCKED_CANDIDATE"{n++}END{print n+0}' "$RESOURCE_RESULTS")"
  SLOW_COUNT="$(awk -F '\t' 'NR>1&&$2=="SLOW_CANDIDATE"{n++}END{print n+0}' "$RESOURCE_RESULTS")"
  OK_COUNT="$(awk -F '\t' 'NR>1&&$2=="OK"{n++}END{print n+0}' "$RESOURCE_RESULTS")"
  awk -F '\t' 'NR>1 && ($2=="BLOCKED_CANDIDATE" || $2=="SLOW_CANDIDATE" || $2=="HTTPS_FAIL"){print $1}' "$RESOURCE_RESULTS" | head -n 40 > "$BASE/last-problematic.txt"
  log "Resource scan [$LABEL]: OK=$OK_COUNT SLOW=$SLOW_COUNT BLOCKED=$BLOCKED_COUNT tested=$COUNT"
}

build_resource_list(){
  resource_matrix_init
  resource_matrix_build_candidate "$SPEED"
  prepare_resource_suite
  if [ "${BASELINE_VALID:-0}" = 0 ]; then
    printf 'domain\tstatus\treason\thttp_code\tdns_s\tconnect_s\ttotal_s\n' > "$RESOURCE_RESULTS"
    BLOCKED_COUNT=0; SLOW_COUNT=0; OK_COUNT=0; return 0
  fi
  case "$SPEED" in
    quick) SCAN_MAX=6;;
    standard) SCAN_MAX=12;;
    deep) SCAN_MAX=40;;
    *) SCAN_MAX=40;;
  esac
  scan_resource_suite discovery "$SCAN_MAX" all
}

resource_score_file(){
  F="$1"
  [ -s "$F" ] || { echo 999999; return; }
  awk -F '\t' 'NR>1 {s=$2; if(s=="OK")w=0; else if(s=="SLOW_CANDIDATE")w=1; else if(s=="HTTPS_FAIL")w=2; else if(s=="BLOCKED_CANDIDATE")w=3; else w=2; sum+=w} END{print sum+0}' "$F"
}
resource_summary(){
  F="$1"
  [ -s "$F" ] || { echo 'score=NA'; return; }
  printf 'score=%s ok=%s slow=%s https_fail=%s blocked=%s\n' \
    "$(resource_score_file "$F")" \
    "$(awk -F '\t' 'NR>1&&$2=="OK"{n++}END{print n+0}' "$F")" \
    "$(awk -F '\t' 'NR>1&&$2=="SLOW_CANDIDATE"{n++}END{print n+0}' "$F")" \
    "$(awk -F '\t' 'NR>1&&$2=="HTTPS_FAIL"{n++}END{print n+0}' "$F")" \
    "$(awk -F '\t' 'NR>1&&$2=="BLOCKED_CANDIDATE"{n++}END{print n+0}' "$F")"
}
benchmark_resources(){
  LABEL="$1"
  OUT="$BASE/benchmark-$LABEL.tsv"
  # Reuse a fresh scan result for 10 minutes; this avoids duplicate probes
  # when several UI/optimizer actions are invoked close together.
  NOW="$(date +%s 2>/dev/null || echo 0)"
  if [ "$LABEL" = baseline ] && [ -s "$RESOURCE_RESULTS" ] && [ -f "$BASE/resource-results.ts" ]; then
    TS="$(cat "$BASE/resource-results.ts" 2>/dev/null || echo 0)"
    case "$TS" in ''|*[!0-9]*) TS=0;; esac
    if [ $((NOW-TS)) -lt "$RESOURCE_CACHE_TTL" ]; then cp -f "$RESOURCE_RESULTS" "$OUT"; resource_score_file "$OUT"; return; fi
  fi
  if [ ! -f "$BASE/candidates.txt" ]; then build_resource_list; fi
  if [ "$LABEL" = baseline ] && [ -s "$RESOURCE_RESULTS" ]; then
    cp -f "$RESOURCE_RESULTS" "$OUT"
  elif [ "$LABEL" = baseline ] || [ ! -s "$BASE/last-problematic.txt" ]; then
    case "$SPEED" in quick) MAX=6;; standard) MAX=12;; deep) MAX=40;; esac
    scan_resource_suite "$LABEL" "$MAX" all; cp -f "$RESOURCE_RESULTS" "$OUT"
  else
    case "$SPEED" in quick) MAX=4;; standard) MAX=8;; deep) MAX=20;; esac
    scan_resource_suite "$LABEL" "$MAX" problematic; cp -f "$RESOURCE_RESULTS" "$OUT"
  fi
  date +%s > "$BASE/resource-results.ts" 2>/dev/null || true
  SCORE="$(resource_score_file "$OUT")"; SUMMARY="$(resource_summary "$OUT")"
  printf '%s\t%s\t%s\n' "$LABEL" "$SCORE" "$SUMMARY" >> "$BASE/strategy-history.tsv"
  log "  $LABEL: $SUMMARY"
  printf '%s\n' "$SCORE"
}

append_strategy_history(){
  [ -f "$BASE/strategy-history.tsv" ] || printf 'strategy\tscore\tsummary\n' > "$BASE/strategy-history.tsv"
}
resource_strategy_signal(){
  [ -f "$RESOURCE_RESULTS" ] || build_resource_list
  BLOCKED_COUNT="$(awk -F '\t' 'NR>1 && $2=="BLOCKED_CANDIDATE"{n++}END{print n+0}' "$RESOURCE_RESULTS")"; SLOW_COUNT="$(awk -F '\t' 'NR>1 && $2=="SLOW_CANDIDATE"{n++}END{print n+0}' "$RESOURCE_RESULTS")"; OK_COUNT="$(awk -F '\t' 'NR>1 && $2=="OK"{n++}END{print n+0}' "$RESOURCE_RESULTS")"; export BLOCKED_COUNT SLOW_COUNT OK_COUNT
  log "Strategy resource signal: blocked_candidates=$BLOCKED_COUNT slow_candidates=$SLOW_COUNT ok=$OK_COUNT"
}

RESOURCE_URLS="https://openwrt.org/ https://github.com/ https://www.cloudflare.com/"
probe_resources(){
  label="$1"; out="$2"; : > "$out"
  log "Resource availability probe ($label):"
  for url in $RESOURCE_URLS; do
    if probe_https "$url"; then
      printf 'https=%s|PASS\n' "$url" >> "$out"
      log "  $url : PASS"
    else
      printf 'https=%s|FAIL\n' "$url" >> "$out"
      log "  $url : FAIL"
    fi
  done
  for n in openwrt.org github.com cloudflare.com; do
    if probe_dns_name "$n"; then
      printf 'dns=%s|PASS\n' "$n" >> "$out"
    else
      printf 'dns=%s|FAIL\n' "$n" >> "$out"
    fi
  done
}
resource_score(){
  f="$1"; RESOURCE_PASS=0; RESOURCE_FAIL=0
  [ -f "$f" ] || return 0
  RESOURCE_PASS="$(grep -c '|PASS$' "$f" 2>/dev/null || echo 0)"
  RESOURCE_FAIL="$(grep -c '|FAIL$' "$f" 2>/dev/null || echo 0)"
}
runtime_baseline(){
  log 'Runtime connectivity baseline:'
  probe_resources baseline "$BASE/baseline-resources.txt"
}
select_profile(){
  measure_resources
  resource_score "$BASE/strategy-resources.txt"
  # Resource availability is now an explicit input to strategy selection.
  if [ "$IMMUTABLE" = 1 ]; then PROFILE_RESOLVED=dns; REASON='immutable/vendor'; return; fi
  if [ "$RAM_TOTAL_KB" -gt 0 ] && [ "$RAM_TOTAL_KB" -lt 65536 ]; then PROFILE_RESOLVED=minimal; REASON='low-RAM'; return; fi
  if [ "$ROOT_FREE_KB" -gt 0 ] && [ "$ROOT_FREE_KB" -lt 8192 ]; then PROFILE_RESOLVED=dns; REASON='low-storage'; return; fi
  if [ "$RESOURCE_PASS" -eq 0 ] && [ "$RESOURCE_FAIL" -gt 0 ]; then PROFILE_RESOLVED=dns; REASON='no-baseline-resources'; return; fi
  PROFILE_RESOLVED=full; REASON='resources-and-baseline-available';
}
auto_optimize(){
  measure_resources
  if [ "$SPEED" = auto ]; then
    if [ "$RAM_TOTAL_KB" -gt 0 ] && [ "$RAM_TOTAL_KB" -lt 65536 ]; then SPEED=quick;
    elif [ "$RAM_TOTAL_KB" -gt 0 ] && [ "$RAM_TOTAL_KB" -lt 131072 ]; then SPEED=standard;
    else SPEED=standard; fi
  fi
  log 'Adaptive resource + connectivity assessment:'
  log "  test speed: $SPEED"
  log "  RAM total: ${RAM_TOTAL_KB} KB"
  log "  RAM available: ${RAM_FREE_KB} KB"
  log "  root free: ${ROOT_FREE_KB} KB"
  # One discovery pass. Its candidate list and baseline are reused by all later benchmarks.
  build_resource_list
  probe_resources strategy "$BASE/strategy-resources.txt"
  resource_score "$BASE/strategy-resources.txt"
  resource_strategy_signal
  log "  resource probes: PASS=${RESOURCE_PASS} FAIL=${RESOURCE_FAIL}"
  if [ "$PROFILE" = auto ]; then select_profile; else set_resolved_profile; REASON="user-profile:$PROFILE"; fi
  log "  selected profile: $PROFILE_RESOLVED ($REASON)"
  if [ "$PROFILE_RESOLVED" = full ] && [ "$IMMUTABLE" = 0 ] && [ "$RESOURCE_PASS" -gt 0 ]; then MODULE_RESOLVED=auto; else MODULE_RESOLVED=core; fi
  if [ "${BLOCKED_COUNT:-0}" -eq 0 ] && [ "${SLOW_COUNT:-0}" -eq 0 ]; then log '  no local blocked/slow candidates; optional modules will not be benchmarked'; else log "  problematic candidates: blocked=${BLOCKED_COUNT:-0} slow=${SLOW_COUNT:-0}"; fi
  log "  selected module policy: $MODULE_RESOLVED"
}

run_core_benchmarked(){
  append_strategy_history
  module_snapshot core
  BEFORE_SCORE="$(benchmark_resources baseline)"
  log 'Applying core backend for adaptive benchmark'
  if ! run_backend; then module_restore || true; return 1; fi
  sleep 1
  AFTER_SCORE="$(benchmark_resources core)"
  if [ "$AFTER_SCORE" -gt "$BEFORE_SCORE" ]; then log "Core worsened score ($BEFORE_SCORE -> $AFTER_SCORE); rollback"; module_restore || true; return 1; fi
  log "Core accepted ($BEFORE_SCORE -> $AFTER_SCORE)"; return 0
}

run_optional_benchmark(){
  NAME="$1"
  module_preflight "$NAME" || { log "$NAME: incompatible -> SKIP"; return 2; }
  BEFORE_SCORE="$(resource_score_file "$RESOURCE_RESULTS")"
  [ "$BEFORE_SCORE" -lt 999999 ] || BEFORE_SCORE="$(benchmark_resources before-$NAME)"
  module_snapshot "$NAME"
  log "Benchmarking strategy candidate: $NAME"
  if ! run_module "$NAME"; then log "$NAME failed -> rejected"; return 1; fi
  sleep 1
  AFTER_SCORE="$(benchmark_resources after-$NAME)"
  if [ "$AFTER_SCORE" -lt "$BEFORE_SCORE" ]; then log "$NAME accepted: $BEFORE_SCORE -> $AFTER_SCORE"; return 0; fi
  log "$NAME rejected/neutral: $BEFORE_SCORE -> $AFTER_SCORE; rollback"
  module_restore || true
  : > "$RESOURCE_RESULTS"
  return 1
}

adaptive_strategy_install(){
  log '=== Adaptive strategy benchmark (load-optimized) ==='
  : > "$BASE/strategy-history.tsv"; printf 'strategy\tscore\tsummary\n' > "$BASE/strategy-history.tsv"
  benchmark_resources baseline >/dev/null
  BASELINE_SCORE="$(resource_score_file "$BASE/benchmark-baseline.tsv")"
  log "Baseline resource score=$BASELINE_SCORE"
  if ! run_core_benchmarked; then log 'Core benchmark failed/rejected'; return 1; fi
  # If core solved the observed problems, stop. This avoids expensive tunnel tests.
  CURRENT_SCORE="$(resource_score_file "$RESOURCE_RESULTS")"
  if [ "${BLOCKED_COUNT:-0}" -eq 0 ] && [ "${SLOW_COUNT:-0}" -eq 0 ]; then
    log 'Core restored all observed candidates; skipping optional modules to minimize CPU/RAM/network load.'
    return 0
  fi
  for M in dpi-desync awg-warp podkop proxy; do
    [ "${BLOCKED_COUNT:-0}" -eq 0 ] && [ "${SLOW_COUNT:-0}" -eq 0 ] && break
    module_preflight "$M" || continue
    run_optional_benchmark "$M" || true
  done
  FINAL_SCORE="$(resource_score_file "$RESOURCE_RESULTS")"
  log "Final adaptive strategy score=$FINAL_SCORE"
  log 'Strategy ranking/history:'; cat "$BASE/strategy-history.tsv" | tee -a "$LOG" >/dev/null
  MODULE_RESOLVED=auto; return 0
}

post_install_test(){
  log 'Post-install connectivity/resource test:'
  runtime_baseline
  if have ip; then
    log '  default route:'
    ip route 2>/dev/null | grep '^default ' | head -n 2 | tee -a "$LOG" >/dev/null || true
  fi
  if have nft && [ "$FW" = fw4 ]; then
    nft list ruleset >/dev/null 2>&1 && log '  nft ruleset: readable' || log '  nft ruleset: WARN'
  fi
}

# ---------- backup ----------
backup(){
  TS="$(date +%Y%m%d-%H%M%S 2>/dev/null || echo manual)"
  DEST="$BACKUP_BASE/$TS"
  [ "$DRY" = 1 ] && { log "+ backup -> $DEST"; return; }
  mkdir -p "$DEST" || die "cannot create backup directory"
  for f in network firewall dhcp system wireless podkop youtubeUnblock https-dns-proxy sing-box; do
    [ -f "/etc/config/$f" ] && cp -p "/etc/config/$f" "$DEST/$f"
  done
  if have uci; then uci show > "$DEST/uci-show.txt" 2>/dev/null || true; fi
  if have sysupgrade; then sysupgrade -b "$DEST/sysupgrade.tar.gz" >/dev/null 2>&1 || true; fi
  printf '%s\n' "$DEST" > "$BACKUP_BASE/LATEST"
  log "Backup=$DEST"
}

# ---------- backend ----------
download(){
  OUT="$1"
  [ -n "$BACKEND_URL" ] || { log 'External backend is disabled by default. Set --backend-url/--backend-sha256 (or UOW_BACKEND_URL/UOW_BACKEND_SHA256) to enable a pinned backend.'; return 2; }
  case "$BACKEND_URL" in https://*) ;; *) log 'External backend URL must use HTTPS'; return 2;; esac
  if have curl; then curl -fL --connect-timeout 15 --max-time 180 "$BACKEND_URL" -o "$OUT"
  elif have wget; then wget -O "$OUT" "$BACKEND_URL"
  else return 127; fi
}

fetch_backend(){
  ARCHIVE="$BASE/backend.tar.gz"
  SRC="$BASE/src"
  rm -rf "$SRC" "$BASE/backend.tar.gz" 2>/dev/null || true
  mkdir -p "$SRC"
  if [ -z "$BACKEND_URL" ]; then log '+ external backend disabled (set --backend-url/--backend-sha256 or UOW_BACKEND_URL/UOW_BACKEND_SHA256 to opt in)'; return 2; fi
  if [ "$DRY" = 1 ]; then log "+ download pinned backend $BACKEND_URL"; return; fi
  download "$ARCHIVE" || die 'cannot download pinned backend'
  [ -n "$BACKEND_SHA256" ] || die 'UOW_BACKEND_SHA256 is required when external backend is enabled'
  have sha256sum || die 'sha256sum is required for external backend verification'
  printf '%s  %s\n' "$BACKEND_SHA256" "$ARCHIVE" | sha256sum -c - >/dev/null 2>&1 || die 'external backend SHA256 verification failed'
  tar -xzf "$ARCHIVE" -C "$SRC" || die 'cannot unpack backend'
  ROOT="$(find "$SRC" -mindepth 1 -maxdepth 1 -type d | head -n1)"
  [ -n "$ROOT" ] || die 'backend root not found'
  [ -f "$ROOT/install.sh" ] || die 'backend install.sh missing'
  [ -f "$ROOT/lib/common.sh" ] || die 'backend lib/common.sh missing'
  printf '%s\n' "$ROOT" > "$BASE/BACKEND_ROOT"
}

run_backend(){
  [ "$DRY" = 1 ] && { log '+ backend install skipped (dry-run)'; return; }
  ROOT="$(cat "$BASE/BACKEND_ROOT")"
  export UNIVERSAL_WRAPPER=1
  export UNIVERSAL_MODEL="$MODEL"
  export UNIVERSAL_BOARD="$BOARD"
  export UNIVERSAL_OPENWRT="$VERSION_OW"
  export UNIVERSAL_TARGET="$TARGET"
  export UNIVERSAL_ARCH="$ARCH"
  export UNIVERSAL_KERNEL="$KERNEL"
  export UNIVERSAL_PM="$PM"
  export UNIVERSAL_FIREWALL="$FW"
  export UNIVERSAL_IMMUTABLE="$IMMUTABLE"
  export UNIVERSAL_LAN_DEVICE="$LAN_DEV"
  export UNIVERSAL_WAN_DEVICE="$WAN_DEV"
  export UNIVERSAL_DEFAULT_IF="$DEFAULT_IF"
  export UNIVERSAL_DNSMASQ_SECTION="$DNSMASQ"
  log 'Starting backend with detected capabilities...'
  # Default profile is deliberately conservative. The backend remains responsible
  # for its own package/version checks and module-specific rollback.
  ARGS='-y'
  case "$PROFILE_RESOLVED" in
    minimal) ARGS='-y --no-malw --no-quic --no-overrides' ;;
    dns) ARGS='-y --no-quic --no-overrides' ;;
    full) ARGS='-y' ;;
  esac
  # BusyBox ash has no PIPESTATUS. Run backend separately so failures are not masked.
  OUT="$BASE/backend.out"
  : > "$OUT"
  # shellcheck disable=SC2086
  sh "$ROOT/install.sh" $ARGS >"$OUT" 2>&1
  RC=$?
  cat "$OUT" | tee -a "$LOG" >/dev/null
  if [ "$RC" != 0 ]; then
    log "Backend returned status $RC"
    log "Backend failure captured in $OUT"
    return "$RC"
  fi
  return 0
}

# ---------- transactional modules ----------
module_snapshot(){
  NAME="$1"; TS="$(date +%Y%m%d-%H%M%S 2>/dev/null || echo manual)"
  MOD_BACKUP="$BACKUP_BASE/modules/$NAME-$TS"
  mkdir -p "$MOD_BACKUP" || die "cannot create module backup"
  for f in network firewall dhcp system wireless podkop youtubeUnblock https-dns-proxy sing-box; do
    [ -f "/etc/config/$f" ] && cp -p "/etc/config/$f" "$MOD_BACKUP/$f"
  done
  [ -d /etc/universal-openwrt/awg ] && cp -a /etc/universal-openwrt/awg "$MOD_BACKUP/awg" 2>/dev/null || true
  [ -f "${TGGO_CONF:-/etc/universal-openwrt/tg-socks5.conf}" ] && cp -p "${TGGO_CONF:-/etc/universal-openwrt/tg-socks5.conf}" "$MOD_BACKUP/tg-socks5.conf" 2>/dev/null || true
  [ -f "${TG_FAILOVER_CONF:-/etc/universal-openwrt/tg-failover.conf}" ] && cp -p "${TG_FAILOVER_CONF:-/etc/universal-openwrt/tg-failover.conf}" "$MOD_BACKUP/tg-failover.conf" 2>/dev/null || true
  if have uci; then uci show > "$MOD_BACKUP/uci-show.txt" 2>/dev/null || true; fi
  printf '%s\n' "$MOD_BACKUP" > "$BACKUP_BASE/LAST_MODULE"
  log "Module snapshot=$MOD_BACKUP"
}
module_restore(){
  [ -f "$BACKUP_BASE/LAST_MODULE" ] || die 'no module snapshot found'
  DEST="$(cat "$BACKUP_BASE/LAST_MODULE")"
  [ -d "$DEST" ] || die "module snapshot missing: $DEST"
  log "Restoring module snapshot=$DEST"
  for f in network firewall dhcp system wireless podkop youtubeUnblock https-dns-proxy sing-box; do
    if [ -f "$DEST/$f" ]; then
      cp -p "$DEST/$f" "/etc/config/$f"
    elif [ "$f" = podkop ] || [ "$f" = youtubeUnblock ] || [ "$f" = https-dns-proxy ] || [ "$f" = sing-box ]; then
      rm -f "/etc/config/$f" 2>/dev/null || true
    fi
  done
  if [ -d "$DEST/awg" ]; then
    mkdir -p /etc/universal-openwrt
    rm -rf /etc/universal-openwrt/awg 2>/dev/null || true
    cp -a "$DEST/awg" /etc/universal-openwrt/awg 2>/dev/null || true
  fi
  [ -f "$DEST/tg-socks5.conf" ] && { mkdir -p "$(dirname "${TGGO_CONF:-/etc/universal-openwrt/tg-socks5.conf}")"; cp -p "$DEST/tg-socks5.conf" "${TGGO_CONF:-/etc/universal-openwrt/tg-socks5.conf}"; } 2>/dev/null || true
  [ -f "$DEST/tg-failover.conf" ] && { mkdir -p "$(dirname "${TG_FAILOVER_CONF:-/etc/universal-openwrt/tg-failover.conf}")"; cp -p "$DEST/tg-failover.conf" "${TG_FAILOVER_CONF:-/etc/universal-openwrt/tg-failover.conf}"; } 2>/dev/null || true
  uci commit 2>/dev/null || true
  /etc/init.d/network reload 2>/dev/null || true
  /etc/init.d/firewall reload 2>/dev/null || true
  /etc/init.d/dnsmasq restart 2>/dev/null || true
  [ -x /etc/init.d/podkop ] && /etc/init.d/podkop restart 2>/dev/null || true
  [ -x /etc/init.d/sing-box ] && /etc/init.d/sing-box restart 2>/dev/null || true
}
module_health(){
  detect
  OK=1
  if ! uci show network >/dev/null 2>&1 || ! uci show firewall >/dev/null 2>&1 || ! uci show dhcp >/dev/null 2>&1; then OK=0; fi
  if ! ip route 2>/dev/null | grep -q '^default '; then OK=0; fi
  if ! wait_dns; then OK=0; fi
  [ "$OK" = 1 ]
}
run_module(){
  NAME="$1"; shift
  [ -n "${ROOT:-}" ] || fetch_backend
  SCRIPT="$ROOT/modules/$NAME.sh"
  [ -f "$SCRIPT" ] || die "module not found: $NAME"
  module_snapshot "$NAME"
  OUT="$BASE/module-$NAME.out"; : > "$OUT"
  log "Installing module: $NAME"
  # shellcheck disable=SC2086
  sh "$SCRIPT" "$@" >"$OUT" 2>&1
  RC=$?
  cat "$OUT" | tee -a "$LOG" >/dev/null
  if [ "$RC" != 0 ]; then
    log "Module $NAME failed with status $RC; restoring configuration snapshot"
    module_restore
    return "$RC"
  fi
  if ! module_health; then
    log "Module $NAME degraded router health; restoring configuration snapshot"
    module_restore
    return 1
  fi
  log "Module $NAME completed successfully"
  return 0
}
module_preflight(){
  NAME="$1"
  case "$NAME" in
    awg-warp)
      [ "$IMMUTABLE" = 0 ] || { log 'AWG: immutable root -> SKIP'; return 1; }
      [ "$PM" != none ] || { log 'AWG: no package manager -> SKIP'; return 1; }
      [ -n "$KERNEL" ] || { log 'AWG: unknown kernel -> SKIP'; return 1; }
      ;;
    podkop)
      [ "$IMMUTABLE" = 0 ] || { log 'Podkop: immutable root -> SKIP'; return 1; }
      [ "$FW" = fw4 ] || { log 'Podkop: fw4 required -> SKIP'; return 1; }
      ;;
    proxy)
      [ "$PM" != none ] || { log 'Proxy: no package manager -> SKIP'; return 1; }
      [ "$IMMUTABLE" = 0 ] || { log 'Proxy: immutable root -> SKIP'; return 1; }
      ;;
    dpi-desync|doh-unpoison|malw-hosts)
      module_exists "$NAME" || { log "$NAME: module unavailable -> SKIP"; return 1; }
      ;;
    *) return 1;;
  esac
  return 0
}

run_selected_modules(){
  case "$MODULE" in
    core) run_backend || return $? ;;
    doh-unpoison|malw-hosts|dpi-desync|awg-warp|podkop|proxy)
      module_preflight "$MODULE" || return 0
      case "$MODULE" in
        awg-warp) awg_auto_setup ;;
        dpi-desync) run_module_verified "$MODULE" try ;;
        *) run_module_verified "$MODULE" ;;
      esac
      ;;
    all)
      # Core already contains DoH/QUIC/DPI/geo logic. Do not install those twice.
      run_backend || return $?
      for M in awg-warp podkop proxy; do
        if module_preflight "$M"; then
          run_module_verified "$M" || log "$M failed/rolled back; continuing with remaining modules"
        else
          log "$M not compatible with detected device; skipped"
        fi
      done
      ;;
    auto)
      auto_optimize
      adaptive_strategy_install || return $?
      ;;
    *) die "unknown module: $MODULE";;
  esac
}


# ---------- AWG/WARP automatic registration + VPN routing ----------
# The upstream awg-warp module performs WARP device registration/config generation
# and installs the exact AmneziaWG packages for the detected OpenWrt release/kernel.
# This wrapper adds transactional routing mode, status export and post-connect checks.
validate_vpn_mode(){
  case "$VPN_MODE" in full|split|off) return 0;; *) die "invalid --vpn-mode: $VPN_MODE (use full|split|off)";; esac
}
awg_registration_status(){
  detect
  IFACE="${AWG_IFACE:-awg10}"
  log "AWG/WARP status for $IFACE:"
  if ! uci -q get "network.$IFACE.proto" >/dev/null 2>&1; then
    log '  registration: NOT CONFIGURED'; return 1
  fi
  log '  protocol: '"$(uci -q get "network.$IFACE.proto" 2>/dev/null || echo unknown)"
  log '  address:  '"$(uci -q get "network.$IFACE.addresses" 2>/dev/null || echo unknown)"
  log '  endpoint: '"$(uci -q get "network.@wireguard_${IFACE}[-1].endpoint_host" 2>/dev/null || uci -q get "network.@amneziawg_${IFACE}[-1].endpoint_host" 2>/dev/null || echo unknown)"
  log '  packages: tools='"$(command -v awg >/dev/null 2>&1 && echo installed || echo missing)"
  log '  kernel:   '"([ -e /sys/module/amneziawg ] && echo loaded || echo not-loaded)"
  if [ -s /etc/universal-openwrt/awg/warp-identity.json ]; then log '  identity: AUTO-REGISTERED'; else log '  identity: NOT-REGISTERED'; fi
  if [ -s /etc/universal-openwrt/awg/awg.conf ]; then log '  config:   AUTO-GENERATED'; else log '  config:   MISSING'; fi
  if ip link show "$IFACE" >/dev/null 2>&1; then log '  interface: UP/present'; else log '  interface: DOWN/missing'; fi
}
awg_apply_routing(){
  IFACE="${AWG_IFACE:-awg10}"
  [ "$VPN_MODE" = off ] && return 0
  [ "$VPN_MODE" = full ] || return 0
  [ -n "$(uci -q get "network.$IFACE.proto" 2>/dev/null)" ] || die "AWG interface $IFACE is not configured"
  # Keep the tunnel endpoint reachable through WAN while routing client traffic via AWG.
  # netifd handles the endpoint route; we only enable allowed-IPs routing here.
  PEER="$(uci show network 2>/dev/null | sed -n "s/^network\.\(@[^=]*\)\.public_key=.*/\1/p" | tail -n 1)"
  [ -n "$PEER" ] || PEER="@wireguard_${IFACE}[-1]"
  uci set "network.${PEER}.allowed_ips=0.0.0.0/0" 2>/dev/null || true
  uci set "network.${PEER}.route_allowed_ips=1" 2>/dev/null || true
  uci set "network.$IFACE.nohostroute=0" 2>/dev/null || true
  uci commit network
  ifdown "$IFACE" 2>/dev/null || true
  ifup "$IFACE" 2>/dev/null || true
  sleep 2
  log "AWG full-tunnel routing enabled on $IFACE"
}
awg_auto_setup(){
  [ "$DRY" = 1 ] && { log '+ AWG/WARP automatic registration + VPN setup'; return 0; }
  fetch_backend
  ROOT="$(cat "$BASE/BACKEND_ROOT")"
  module_preflight awg-warp || return 1
  module_snapshot awg-warp
  OUT="$BASE/module-awg-warp.out"; : > "$OUT"
  log 'AWG: automatic package selection + WARP registration/config generation'
  sh "$ROOT/modules/awg-warp.sh" --iface "${AWG_IFACE:-awg10}" --lan-zone "${LAN_ZONE:-lan}" >"$OUT" 2>&1
  RC=$?
  cat "$OUT" | tee -a "$LOG" >/dev/null
  [ "$RC" = 0 ] || { log "AWG module failed ($RC)"; module_restore; return "$RC"; }
  awg_apply_routing
  module_health || { log 'AWG health check failed; rolling back'; module_restore; return 1; }
  awg_registration_status || true
  if [ "$VPN_MODE" = full ]; then
    if ! ping -c 1 -W 3 1.1.1.1 >/dev/null 2>&1; then
      log 'AWG full-tunnel connectivity check failed; rolling back AWG routing/config'
      module_restore; return 1
    fi
  fi
  log 'AWG/WARP automatic setup: PASS'
}


# ---------- AWG/WARP profile manager ----------
VPN_PROFILES_DIR='/etc/universal-openwrt/vpn-profiles'
VPN_PROFILE_FILE="${VPN_PROFILES_DIR}/profiles.db"
mkdir -p "$VPN_PROFILES_DIR" 2>/dev/null || true
vpn_profiles_init(){
  mkdir -p "$VPN_PROFILES_DIR" 2>/dev/null || return 1
  [ -f "$VPN_PROFILE_FILE" ] || : > "$VPN_PROFILE_FILE"
}
vpn_profile_name_ok(){ printf '%s' "$1" | grep -Eq '^[A-Za-z0-9._-]{1,48}$'; }
vpn_profile_list(){
  vpn_profiles_init || return 1
  log "VPN profiles:"
  if [ ! -s "$VPN_PROFILE_FILE" ]; then log '  (none)'; return 0; fi
  awk -F'|' '{printf "  %-20s %-7s %-8s %-s\\n",$1,$2,$3,$4}' "$VPN_PROFILE_FILE"
}
vpn_profile_save(){
  NAME="$1"; MODE="$2"; IFACE="${3:-awg10}"; DESC="${4:-AWG/WARP profile}"
  vpn_profile_name_ok "$NAME" || die 'invalid profile name'
  case "$MODE" in split|full|off) ;; *) die 'invalid profile mode';; esac
  vpn_profiles_init || die 'cannot create profile database'
  TMP="$VPN_PROFILE_FILE.tmp.$$"
  awk -F'|' -v n="$NAME" '$1 != n' "$VPN_PROFILE_FILE" 2>/dev/null > "$TMP" || true
  printf '%s|%s|%s|%s\\n' "$NAME" "$MODE" "$IFACE" "$(printf '%s' "$DESC" | tr '|\\n' '  ')" >> "$TMP"
  mv "$TMP" "$VPN_PROFILE_FILE"
}
vpn_profile_delete(){
  NAME="$1"; vpn_profile_name_ok "$NAME" || die 'invalid profile name'
  vpn_profiles_init || return 1
  TMP="$VPN_PROFILE_FILE.tmp.$$"
  awk -F'|' -v n="$NAME" '$1 != n' "$VPN_PROFILE_FILE" > "$TMP" 2>/dev/null || true
  mv "$TMP" "$VPN_PROFILE_FILE"
}
vpn_profile_get(){
  NAME="$1"; vpn_profiles_init || return 1
  awk -F'|' -v n="$NAME" '$1 == n {print; exit}' "$VPN_PROFILE_FILE"
}
vpn_profile_activate(){
  NAME="$1"; ROW="$(vpn_profile_get "$NAME")"; [ -n "$ROW" ] || die "profile not found: $NAME"
  OLD="$VPN_MODE"; NEW="$(printf '%s' "$ROW" | cut -d'|' -f2)"; IFACE="$(printf '%s' "$ROW" | cut -d'|' -f3)"
  VPN_MODE="$NEW"; AWG_IFACE="$IFACE"
  log "Activating VPN profile '$NAME' ($NEW, $IFACE)"
  awg_apply_routing
  ifdown "$IFACE" 2>/dev/null || true; ifup "$IFACE" 2>/dev/null || true
  sleep 1
  if ip link show "$IFACE" >/dev/null 2>&1; then
    log "VPN profile '$NAME': interface present"
    vpn_profile_active_set "$NAME"
  else
    VPN_MODE="$OLD"; return 1
  fi
}
vpn_profile_benchmark_dir(){
  VPN_PROFILE_BENCH_DIR="$VPN_PROFILES_DIR/benchmark"
  mkdir -p "$VPN_PROFILE_BENCH_DIR" 2>/dev/null || true
}
vpn_profile_prepare_targets(){
  vpn_profile_benchmark_dir
  TARGETS="$VPN_PROFILE_BENCH_DIR/targets.txt"
  if [ -s "$TARGETS" ]; then return 0; fi
  if [ -s "$BASE/last-problematic.txt" ]; then
    cp -f "$BASE/last-problematic.txt" "$TARGETS"
  elif [ -s "$CANDIDATE_FILE" ]; then
    # No previously detected problems: use only a tiny control set.
    head -n 3 "$CANDIDATE_FILE" > "$TARGETS"
  else
    printf '%s\n' openwrt.org cloudflare.com github.com > "$TARGETS"
  fi
}
vpn_profile_active_get(){
  [ -s "$VPN_PROFILES_DIR/active" ] && cat "$VPN_PROFILES_DIR/active" || true
}
vpn_profile_active_set(){
  printf '%s\n' "$1" > "$VPN_PROFILES_DIR/active" 2>/dev/null || true
}
vpn_profile_restore_state(){
  OLD_NAME="$1"
  OLD_MODE="$2"
  OLD_IFACE="$3"
  if [ -n "$OLD_NAME" ] && [ -n "$(vpn_profile_get "$OLD_NAME")" ]; then
    vpn_profile_activate "$OLD_NAME" >/dev/null 2>&1 || true
    return 0
  fi
  VPN_MODE="$OLD_MODE"; AWG_IFACE="$OLD_IFACE"
  [ -n "$OLD_IFACE" ] && { ifdown "$OLD_IFACE" 2>/dev/null || true; ifup "$OLD_IFACE" 2>/dev/null || true; }
  if [ "$OLD_MODE" = full ] && [ -n "$OLD_IFACE" ]; then awg_apply_routing >/dev/null 2>&1 || true; fi
  rm -f "$VPN_PROFILES_DIR/active" 2>/dev/null || true
}
vpn_profile_measure_targets(){
  NAME="$1"
  vpn_profile_benchmark_dir
  vpn_profile_prepare_targets
  OUT="$VPN_PROFILE_BENCH_DIR/$NAME.tsv"
  case "$SPEED" in quick) MAX=5;; standard) MAX=10;; deep) MAX=20;; *) MAX=10;; esac
  TOTAL=0; SUCCESS=0; FAIL=0; LAT_SUM='0'; RESOURCE_SCORE=0
  : > "$OUT"
  printf 'domain\tresult\thttp_code\ttotal_s\n' > "$OUT"
  while IFS= read -r D; do
    [ -n "$D" ] || continue
    T="$(http_probe_timing "https://$D/" 2>/dev/null || true)"
    CODE="$(printf '%s' "$T" | cut -d'|' -f1)"
    TOTAL_T="$(printf '%s' "$T" | cut -d'|' -f5)"
    case "$CODE" in 2*|3*) R=OK; SUCCESS=$((SUCCESS+1));; *) R=FAIL; FAIL=$((FAIL+1)); RESOURCE_SCORE=$((RESOURCE_SCORE+1));; esac
    case "$TOTAL_T" in ''|*[!0-9.]* ) :;; *) LAT_SUM="$(awk -v a="$LAT_SUM" -v b="$TOTAL_T" 'BEGIN{printf "%.4f",a+b}')";; esac
    TOTAL=$((TOTAL+1))
    printf '%s\t%s\t%s\t%s\n' "$D" "$R" "$CODE" "$TOTAL_T" >> "$OUT"
    [ "$TOTAL" -ge "$MAX" ] && break
  done < "$VPN_PROFILE_BENCH_DIR/targets.txt"
  AVG_LAT='9999'
  [ "$TOTAL" -gt 0 ] && AVG_LAT="$(awk -v s="$LAT_SUM" -v n="$TOTAL" 'BEGIN{printf "%.3f",s/n}')"
  SUCCESS_RATE=0; [ "$TOTAL" -gt 0 ] && SUCCESS_RATE=$((SUCCESS*100/TOTAL))
  LOSS=100
  PING_AVG='9999'
  PING_OUT="$VPN_PROFILE_BENCH_DIR/$NAME.ping"
  if ping -c 2 -W 2 1.1.1.1 >"$PING_OUT" 2>&1; then
    LOSS="$(awk -F',' '/packet loss/ {gsub(/%/ ,"",$3); gsub(/^[ \t]+/,"",$3); print $3+0}' "$PING_OUT" | tail -n1)"; [ -n "$LOSS" ] || LOSS=0
    PING_AVG="$(awk -F'/' '/rtt|round-trip/ {print $5}' "$PING_OUT" | tail -n1)"; [ -n "$PING_AVG" ] || PING_AVG=9999
  else
    LOSS="$(awk -F',' '/packet loss/ {gsub(/%/ ,"",$3); gsub(/^[ \t]+/,"",$3); print $3+0}' "$PING_OUT" | tail -n1)"; [ -n "$LOSS" ] || LOSS=100
  fi
  HANDSHAKE='unknown'
  IFACE="$(printf '%s' "$(vpn_profile_get "$NAME")" | cut -d'|' -f3)"
  if have wg && wg show "$IFACE" latest-handshakes >/dev/null 2>&1; then
    HS="$(wg show "$IFACE" latest-handshakes 2>/dev/null | awk '$2>0{print $2}' | tail -n1)"
    [ -n "$HS" ] && HANDSHAKE='yes' || HANDSHAKE='no'
  elif have awg && awg show "$IFACE" latest-handshakes >/dev/null 2>&1; then
    HS="$(awg show "$IFACE" latest-handshakes 2>/dev/null | awk '$2>0{print $2}' | tail -n1)"
    [ -n "$HS" ] && HANDSHAKE='yes' || HANDSHAKE='no'
  fi
  # Primary objective: make previously failing resources reachable. Latency/loss are tie-breakers.
  SCORE=$((RESOURCE_SCORE*1000 + (100-SUCCESS_RATE)*10 + LOSS*2))
  case "$AVG_LAT" in ''|9999) :;; *) SCORE="$(awk -v s="$SCORE" -v l="$AVG_LAT" 'BEGIN{printf "%d",s+l}')";; esac
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$NAME" "$SCORE" "$SUCCESS_RATE" "$AVG_LAT" "$LOSS" "$TOTAL" "$HANDSHAKE" "$IFACE" > "$VPN_PROFILE_BENCH_DIR/$NAME.result"
  log "  profile=$NAME score=$SCORE success=${SUCCESS_RATE}% avg_ms=${AVG_LAT} loss=${LOSS}% handshake=$HANDSHAKE targets=$TOTAL"
  cat "$VPN_PROFILE_BENCH_DIR/$NAME.result"
}
vpn_profile_benchmark(){
  NAME="$1"
  [ -n "$(vpn_profile_get "$NAME")" ] || die "profile not found: $NAME"
  vpn_profile_benchmark_dir
  OLD_NAME="$(vpn_profile_active_get)"; OLD_MODE="$VPN_MODE"; OLD_IFACE="${AWG_IFACE:-awg10}"
  vpn_profile_activate "$NAME" >/dev/null 2>&1 || { log "profile=$NAME activation failed"; return 1; }
  vpn_profile_measure_targets "$NAME"
  vpn_profile_restore_state "$OLD_NAME" "$OLD_MODE" "$OLD_IFACE"
  date +%s > "$VPN_PROFILE_BENCH_DIR/$NAME.ts" 2>/dev/null || true
}
vpn_profile_benchmark_all(){
  vpn_profiles_init || return 1
  vpn_profile_benchmark_dir
  vpn_profile_prepare_targets
  OLD_NAME="$(vpn_profile_active_get)"; OLD_MODE="$VPN_MODE"; OLD_IFACE="${AWG_IFACE:-awg10}"
  : > "$VPN_PROFILE_BENCH_DIR/ranking.tsv"
  printf 'profile\tscore\tsuccess_rate\tavg_latency\tloss\ttargets\thandshake\tinterface\n' > "$VPN_PROFILE_BENCH_DIR/ranking.tsv"
  COUNT=0
  while IFS='|' read -r NAME MODE IFACE DESC; do
    [ -n "$NAME" ] || continue
    if vpn_profile_activate "$NAME" >/dev/null 2>&1; then
      vpn_profile_measure_targets "$NAME" | tail -n 1 >> "$VPN_PROFILE_BENCH_DIR/ranking.tsv"
      COUNT=$((COUNT+1))
    else
      log "  profile=$NAME activation failed -> skip"
    fi
    vpn_profile_restore_state "$OLD_NAME" "$OLD_MODE" "$OLD_IFACE"
  done < "$VPN_PROFILE_FILE"
  if [ "$COUNT" -eq 0 ]; then log 'No VPN profiles could be benchmarked'; return 1; fi
  { head -n 1 "$VPN_PROFILE_BENCH_DIR/ranking.tsv"; tail -n +2 "$VPN_PROFILE_BENCH_DIR/ranking.tsv" | sort -t "$(printf '\t')" -k2,2n; } > "$VPN_PROFILE_BENCH_DIR/ranking.sorted.tsv"
  cat "$VPN_PROFILE_BENCH_DIR/ranking.sorted.tsv"
}
vpn_profile_auto_select(){
  vpn_profiles_init || return 1
  [ -s "$VPN_PROFILE_FILE" ] || { log 'No saved VPN profiles'; return 1; }
  vpn_profile_benchmark_all >/dev/null || return 1
  RANK="$VPN_PROFILE_BENCH_DIR/ranking.sorted.tsv"
  BEST="$(awk -F'\t' 'NR==2{print $1}' "$RANK")"
  BEST_SCORE="$(awk -F'\t' 'NR==2{print $2}' "$RANK")"
  [ -n "$BEST" ] || return 1
  log "Best VPN profile by problematic-resource benchmark: $BEST (score=$BEST_SCORE)"
  vpn_profile_activate "$BEST"
  vpn_profile_active_set "$BEST"
}


# ---------- continuous VPN quality monitor ----------
VPN_MONITOR_DIR='/etc/universal-openwrt'
VPN_MONITOR_CFG="$VPN_MONITOR_DIR/monitor.conf"
VPN_MONITOR_STATE="$VPN_MONITOR_DIR/monitor.state"
VPN_MONITOR_LOG='/root/universal-openwrt-vpn-monitor.log'
VPN_MONITOR_LOCK='/var/run/universal-openwrt-v21-monitor.lock'

vpn_monitor_init(){
  mkdir -p "$VPN_MONITOR_DIR" "$VPN_PROFILES_DIR" 2>/dev/null || return 1
  [ -f "$VPN_MONITOR_CFG" ] || cat >"$VPN_MONITOR_CFG" <<'EOF'
enabled=0
interval=900
bad_threshold=2
recover_after=3600
switch_cooldown=1800
probe_targets=3
EOF
  [ -f "$VPN_MONITOR_STATE" ] || cat >"$VPN_MONITOR_STATE" <<'EOF'
bad_count=0
last_switch=0
preferred=
failed_preferred=
EOF
}
vpn_monitor_cfg(){ vpn_monitor_init || return 1; awk -F= -v k="$1" '$1==k{print substr($0,index($0,"=")+1); exit}' "$VPN_MONITOR_CFG"; }
vpn_monitor_set(){ vpn_monitor_init || return 1; K="$1"; V="$2"; T="$VPN_MONITOR_CFG.tmp.$$"; awk -F= -v k="$K" '$1!=k{print}' "$VPN_MONITOR_CFG" >"$T" 2>/dev/null || true; printf '%s=%s\n' "$K" "$V" >>"$T"; mv "$T" "$VPN_MONITOR_CFG"; }
vpn_monitor_state_get(){ vpn_monitor_init || return 1; awk -F= -v k="$1" '$1==k{print substr($0,index($0,"=")+1); exit}' "$VPN_MONITOR_STATE"; }
vpn_monitor_state_set(){ vpn_monitor_init || return 1; K="$1"; V="$2"; T="$VPN_MONITOR_STATE.tmp.$$"; awk -F= -v k="$K" '$1!=k{print}' "$VPN_MONITOR_STATE" >"$T" 2>/dev/null || true; printf '%s=%s\n' "$K" "$V" >>"$T"; mv "$T" "$VPN_MONITOR_STATE"; }
vpn_monitor_log(){ printf '[%s] %s\n' "$(date '+%F %T' 2>/dev/null || echo now)" "$*" >>"$VPN_MONITOR_LOG"; }
vpn_monitor_status(){
  vpn_monitor_init || return 1
  printf 'VPN monitor: enabled=%s interval=%ss bad_threshold=%s recover_after=%ss cooldown=%ss\n' \
    "$(vpn_monitor_cfg enabled)" "$(vpn_monitor_cfg interval)" "$(vpn_monitor_cfg bad_threshold)" "$(vpn_monitor_cfg recover_after)" "$(vpn_monitor_cfg switch_cooldown)"
  printf '  active=%s preferred=%s failed_preferred=%s bad_count=%s last_switch=%s\n' \
    "$(vpn_profile_active_get)" "$(vpn_monitor_state_get preferred)" "$(vpn_monitor_state_get failed_preferred)" "$(vpn_monitor_state_get bad_count)" "$(vpn_monitor_state_get last_switch)"
  [ -f "$VPN_MONITOR_LOG" ] && tail -n 30 "$VPN_MONITOR_LOG"
}
vpn_monitor_enable(){
  vpn_monitor_set enabled 1
  if [ -x /etc/init.d/universal-openwrt-vpn-monitor ]; then /etc/init.d/universal-openwrt-vpn-monitor enable; /etc/init.d/universal-openwrt-vpn-monitor start; fi
  vpn_monitor_log 'monitor enabled'
  vpn_monitor_status
}
vpn_monitor_disable(){
  vpn_monitor_set enabled 0
  if [ -x /etc/init.d/universal-openwrt-vpn-monitor ]; then /etc/init.d/universal-openwrt-vpn-monitor disable; /etc/init.d/universal-openwrt-vpn-monitor stop; fi
  vpn_monitor_log 'monitor disabled'
  vpn_monitor_status
}
vpn_monitor_light_test(){
  vpn_profile_prepare_targets
  MAX="$(vpn_monitor_cfg probe_targets)"; case "$MAX" in ''|*[!0-9]*) MAX=3;; esac
  SUCCESS=0; TOTAL=0; LAT='0'; LOSS=0
  while IFS= read -r D; do
    [ -n "$D" ] || continue
    T="$(http_probe_timing "https://$D/" 2>/dev/null || true)"; C="$(printf '%s' "$T" | cut -d'|' -f1)"; L="$(printf '%s' "$T" | cut -d'|' -f5)"
    case "$C" in 2*|3*) SUCCESS=$((SUCCESS+1));; esac
    case "$L" in ''|*[!0-9.]*) :;; *) LAT="$(awk -v a="$LAT" -v b="$L" 'BEGIN{printf "%.3f",a+b}')";; esac
    TOTAL=$((TOTAL+1)); [ "$TOTAL" -ge "$MAX" ] && break
  done < "$VPN_PROFILE_BENCH_DIR/targets.txt"
  RATE=0; [ "$TOTAL" -gt 0 ] && RATE=$((SUCCESS*100/TOTAL))
  if ping -c 1 -W 2 1.1.1.1 >/dev/null 2>&1; then LOSS=0; else LOSS=100; fi
  AVG=9999; [ "$TOTAL" -gt 0 ] && AVG="$(awk -v s="$LAT" -v n="$TOTAL" 'BEGIN{printf "%.3f",s/n}')"
  printf '%s\t%s\t%s\t%s\n' "$RATE" "$LOSS" "$AVG" "$TOTAL"
}
vpn_monitor_switch_best(){
  OLD="$(vpn_profile_active_get)"; [ -n "$OLD" ] || OLD="$(vpn_monitor_state_get preferred)"
  vpn_profile_benchmark_all >/dev/null 2>&1 || return 1
  RANK="$VPN_PROFILE_BENCH_DIR/ranking.sorted.tsv"; BEST="$(awk -F'\t' 'NR==2{print $1}' "$RANK")"; BS="$(awk -F'\t' 'NR==2{print $2+0}' "$RANK")"
  [ -n "$BEST" ] || return 1
  CS=999999; [ -n "$OLD" ] && CS="$(awk -F'\t' -v p="$OLD" '$1==p{print $2+0;exit}' "$RANK")"; [ -n "$CS" ] || CS=999999
  # Require a meaningful improvement before switching, avoiding flapping between near-equal tunnels.
  if [ "$BEST" != "$OLD" ] && [ "$BS" -lt $((CS-100)) ]; then
    vpn_monitor_log "switch candidate=$BEST score=$BS current=$OLD score=$CS"
    vpn_profile_activate "$BEST" >/dev/null 2>&1 || return 1
    vpn_profile_active_set "$BEST"
    NOW="$(date +%s)"; vpn_monitor_state_set last_switch "$NOW"; vpn_monitor_state_set bad_count 0
    [ -n "$OLD" ] && vpn_monitor_state_set failed_preferred "$OLD"
    return 0
  fi
  return 1
}
vpn_monitor_run(){
  vpn_monitor_init || return 1
  [ "$(vpn_monitor_cfg enabled)" = 1 ] || { vpn_monitor_log 'cycle skipped: disabled'; return 0; }
  if [ -e "$VPN_MONITOR_LOCK" ]; then vpn_monitor_log 'cycle skipped: lock exists'; return 0; fi
  printf '%s\n' "$$" > "$VPN_MONITOR_LOCK"; trap 'rm -f "$VPN_MONITOR_LOCK" 2>/dev/null || true' EXIT
  vpn_profiles_init || return 0
  [ -s "$VPN_PROFILE_FILE" ] || { vpn_monitor_log 'cycle skipped: no profiles'; return 0; }
  ACTIVE="$(vpn_profile_active_get)"
  if [ -z "$ACTIVE" ]; then ACTIVE="$(vpn_monitor_state_get preferred)"; fi
  if [ -z "$ACTIVE" ]; then ACTIVE="$(awk -F'|' 'NR==1{print $1}' "$VPN_PROFILE_FILE")"; vpn_profile_activate "$ACTIVE" >/dev/null 2>&1 || true; vpn_profile_active_set "$ACTIVE"; fi
  vpn_profile_prepare_targets
  RESULT="$(vpn_monitor_light_test)"; RATE="$(printf '%s' "$RESULT" | cut -f1)"; LOSS="$(printf '%s' "$RESULT" | cut -f2)"; AVG="$(printf '%s' "$RESULT" | cut -f3)"; TOTAL="$(printf '%s' "$RESULT" | cut -f4)"
  vpn_monitor_log "active=$ACTIVE success=${RATE}% loss=${LOSS}% avg=${AVG} targets=$TOTAL"
  BAD=0; [ "$RATE" -lt 67 ] && BAD=1; [ "$LOSS" -ge 50 ] && BAD=1
  COUNT="$(vpn_monitor_state_get bad_count)"; case "$COUNT" in ''|*[!0-9]*) COUNT=0;; esac
  if [ "$BAD" = 1 ]; then COUNT=$((COUNT+1)); else COUNT=0; fi
  vpn_monitor_state_set bad_count "$COUNT"
  NOW="$(date +%s)"; LAST="$(vpn_monitor_state_get last_switch)"; case "$LAST" in ''|*[!0-9]*) LAST=0;; esac
  COOL="$(vpn_monitor_cfg switch_cooldown)"; case "$COOL" in ''|*[!0-9]*) COOL=1800;; esac
  if [ "$BAD" = 1 ] && [ "$COUNT" -ge "$(vpn_monitor_cfg bad_threshold)" ]; then
    if [ $((NOW-LAST)) -ge "$COOL" ]; then if vpn_monitor_switch_best; then vpn_monitor_log 'VPN profile failover completed'; else vpn_monitor_log 'VPN profiles did not improve; invoking unified adaptive strategy controller'; adaptive_controller_run >/dev/null 2>&1 && vpn_monitor_log 'adaptive strategy recovery completed' || vpn_monitor_log 'adaptive strategy recovery failed'; fi; else vpn_monitor_log 'failover suppressed by cooldown'; fi
  fi
  # Recovery: periodically test the previously failed preferred profile and return only if clearly better.
  FAILED="$(vpn_monitor_state_get failed_preferred)"; REC="$(vpn_monitor_cfg recover_after)"; case "$REC" in ''|*[!0-9]*) REC=3600;; esac
  if [ -n "$FAILED" ] && [ "$ACTIVE" != "$FAILED" ] && [ $((NOW-LAST)) -ge "$REC" ]; then
    vpn_profile_benchmark "$FAILED" >/dev/null 2>&1 || true
    R="$VPN_PROFILE_BENCH_DIR/$FAILED.result"; FS="$(awk -F'\t' 'NR==1{print $2+0}' "$R" 2>/dev/null || echo 999999)"
    AR="$(awk -F'\t' -v p="$ACTIVE" '$1==p{print $2+0;exit}' "$VPN_PROFILE_BENCH_DIR/ranking.sorted.tsv" 2>/dev/null || echo 999999)"
    if [ "$FS" -lt $((AR-100)) ]; then vpn_profile_activate "$FAILED" >/dev/null 2>&1 && vpn_profile_active_set "$FAILED" && vpn_monitor_state_set last_switch "$NOW" && vpn_monitor_state_set failed_preferred '' && vpn_monitor_log "recovered preferred profile=$FAILED"; fi
  fi
}

