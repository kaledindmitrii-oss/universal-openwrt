    --device-profile) MODE=device_profile; DEVICE_IP="${2:-}"; DEVICE_PROF="${3:-}"; shift 2;;
    --version) printf '%s\n' "Universal OpenWrt v$VERSION"; exit 0;;
    --self-check) MODE=self_check;;
    --self-update) SELF_UPDATE_URL="${2:-}"; SELF_UPDATE_SHA256="${3:-}"; [ -n "$SELF_UPDATE_URL" ] || die 'URL required for --self-update'; [ -n "$SELF_UPDATE_SHA256" ] || die 'SHA256 required for --self-update'; shift 2;;
    --predictive-status) MODE=predictive_status;;
    --strategy-plan) MODE=strategy_plan;;
