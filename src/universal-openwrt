  --vpn-monitor-status  show continuous VPN monitor status
  --vpn-monitor-enable  enable automatic VPN failover/recovery monitor
  --vpn-monitor-disable disable automatic VPN failover/recovery monitor
  --vpn-monitor-run     run one low-load monitor cycle
  --adaptive-auto       benchmark DPI/DNS/AWG/Podkop/Proxy strategies and activate the best
