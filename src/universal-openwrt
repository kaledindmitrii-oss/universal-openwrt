    --vpn-profile-create) MODE=vpn_profile_create; shift; VPN_PROFILE_NAME="${1:-}"; shift; VPN_PROFILE_MODE="${1:-}"; shift; VPN_PROFILE_IFACE="${1:-awg10}"; shift; VPN_PROFILE_DESC="${1:-AWG/WARP profile}";;
    --vpn-profile-delete) MODE=vpn_profile_delete; shift; VPN_PROFILE_NAME="${1:-}";;
    --vpn-profile-activate) MODE=vpn_profile_activate; shift; VPN_PROFILE_NAME="${1:-}";;
    --vpn-profile-test) MODE=vpn_profile_test; shift; VPN_PROFILE_NAME="${1:-}";;
    --vpn-profile-benchmark) MODE=vpn_profile_benchmark; shift; VPN_PROFILE_NAME="${1:-}";;
    --vpn-profile-auto) MODE=vpn_profile_auto;;
