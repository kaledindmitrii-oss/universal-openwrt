validate_speed
validate_vpn_mode
if [ -n "${SELF_UPDATE_URL:-}" ]; then
  TMP_UPDATE="/tmp/universal-openwrt-update.$$"
  if have uclient-fetch; then uclient-fetch -q -O "$TMP_UPDATE" "$SELF_UPDATE_URL"; elif have wget; then wget -q -O "$TMP_UPDATE" "$SELF_UPDATE_URL"; elif have curl; then curl -fsSL -o "$TMP_UPDATE" "$SELF_UPDATE_URL"; else die "No downloader available"; fi
  [ -s "$TMP_UPDATE" ] || die "Downloaded update is empty"
  have sha256sum || die "sha256sum required for --self-update"
  printf '%s  %s\n' "$SELF_UPDATE_SHA256" "$TMP_UPDATE" | sha256sum -c - >/dev/null 2>&1 || die "SHA256 verification failed"
  chmod 0755 "$TMP_UPDATE"
  sh -n "$TMP_UPDATE" || die "Downloaded update failed shell syntax check"
  install -m 0755 "$TMP_UPDATE" "$0.new" 2>/dev/null || cp "$TMP_UPDATE" "$0.new"
  mv "$0.new" "$0"
  rm -f "$TMP_UPDATE"
  exec "$0" --version
fi
case "$MODE" in
  tg_ws_status) tgws_status; exit $?;;
  tg_proxy_status) tg_proxy_load; printf 'Telegram SOCKS5: enabled=%s host=%s port=%s configured=%s\n' "$TG_ENABLED" "${TG_HOST:-unset}" "${TG_PORT:-unset}" "$(tg_proxy_configured && echo yes || echo no)"; exit 0;;
