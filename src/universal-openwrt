  --predictive-auto     diagnose resource failure type and run predictive adaptive recovery
  --device-discover     discover LAN clients and infer device profiles
  --device-benchmark    build device-aware per-client service policy
  --device-status       show device inventory and policies
  --device-profile IP PROFILE  force a client profile (ios/android/windows/tv/gaming/generic)
  --version          show installed version
  --self-check       run lightweight local dependency/integrity checks
  --self-update URL SHA256  replace this script after SHA256 verification
  --predictive-status   show predictive controller state/history
  --speed MODE quick|standard|deep|auto
  -y             non-interactive
USAGE
}

while [ $# -gt 0 ]; do
  case "$1" in
    --diagnose) MODE=diagnose
VPN_PROFILE_NAME=""
VPN_PROFILE_MODE="";;
    --plan) MODE=plan;;
