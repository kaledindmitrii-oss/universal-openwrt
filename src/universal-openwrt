    --tunnel-enable) MODE=tunnel_enable; TUNNEL_NAME="${2:-}"; shift;;
    --tunnel-disable) MODE=tunnel_disable;;
    --tunnel-auto) MODE=tunnel_auto;;
    -y) ASSUME_YES=1;;
    -h|--help) usage; exit 0;;
    *) die "unknown option: $1";;
  esac
  shift
