resource_matrix_class(){
  case "$1" in
    telegram.org|t.me|telegra.ph|telegram.me|telegram.dog) echo telegram;;
    youtube.com|youtube-nocookie.com|googlevideo.com|ytimg.com|youtubei.googleapis.com|yt3.ggpht.com|yt4.ggpht.com|ggpht.com) echo video;;
    instagram.com|cdninstagram.com|ig.me|facebook.com|fbcdn.net|x.com|twitter.com|t.co|ads-twitter.com) echo social;;
    discord.com|discord.gg|discord.media|discordapp.com|discordapp.net) echo discord;;
    tiktok.com|tiktokcdn.com|tiktokv.com) echo social-video;;
    chatgpt.com|openai.com|production-openaicom-storage.azureedge.net|claude.ai|claude.com|groq.com|grok.com|grok.x.com|copilot.microsoft.com) echo ai;;
    github.com|githubusercontent.com|githubassets.com|npmjs.com|pypi.org|docker.com|docker.io|jetbrains.com|cursor.sh|cursorapi.com) echo developer;;
    netflix.com|spotify.com|soundcloud.com|sndcdn.com|primevideo.com|hbomax.com|crunchyroll.com|deezer.com|qobuz.com) echo streaming;;
    steam.com|steampowered.com|steamcommunity.com|steamstat.info|epicgames.com|supercell.com|clashofclans.com|clashroyaleapp.com) echo gaming;;
    bbc.com|bbc.co.uk|dw.com|meduza.io|themoscowtimes.com|rferl.org|svoboda.org|radiosvoboda.org|currenttime.tv|reuters.com) echo news;;
    *) echo generic;;
  esac
}
strategy_capability(){
  case "$1" in
    core) echo ready;;
    dns|doh-unpoison|malw-hosts) module_preflight doh-unpoison >/dev/null 2>&1 || module_preflight malw-hosts >/dev/null 2>&1 && echo ready || echo unavailable;;
    dpi|dpi-youtube-auto|dpi-discord|dpi-game) module_preflight dpi-desync >/dev/null 2>&1 && echo ready || echo unavailable;;
    awg-split|awg-full) module_preflight awg-warp >/dev/null 2>&1 && echo ready || echo unavailable;;
    podkop) module_preflight podkop >/dev/null 2>&1 && echo ready || echo unavailable;;
    proxy) module_preflight proxy >/dev/null 2>&1 && echo ready || echo unavailable;;
    tg-socks5) tggo_installed && echo ready || echo unavailable;;
    tg-ws) tgws_configured && echo ready || echo unavailable;;
    vless-tproxy|sing-box-vless) have sing-box && echo ready || echo unavailable;;
    *) echo unknown;;
  esac
}
STRATEGY_CHANGE_LOCK='/var/run/universal-openwrt-strategy-change.lock'
strategy_change_lock(){ [ -e "$STRATEGY_CHANGE_LOCK" ] && return 1; : > "$STRATEGY_CHANGE_LOCK"; return 0; }
strategy_change_unlock(){ rm -f "$STRATEGY_CHANGE_LOCK" 2>/dev/null || true; }
strategy_apply(){
  strategy_change_lock || { log 'Strategy change already in progress; refusing concurrent mutation'; return 3; }
  _strategy_rc=0
  case "$1" in
    tg-socks5) tggo_enable || _strategy_rc=$?;;
    tg-ws) tgws_enable || _strategy_rc=$?;;
    dpi|dpi-youtube-auto|dpi-discord|dpi-game)
      if ! module_preflight dpi-desync; then _strategy_rc=2
      elif ! run_module_verified dpi-desync try; then _strategy_rc=$?; fi
      ;;
    awg-split)
      module_preflight awg-warp || _strategy_rc=2
      if [ "$_strategy_rc" -eq 0 ]; then VPN_MODE=split; AWG_IFACE=awg10; awg_auto_setup || _strategy_rc=$?; fi
      ;;
    awg-full)
      module_preflight awg-warp || _strategy_rc=2
      if [ "$_strategy_rc" -eq 0 ]; then VPN_MODE=full; AWG_IFACE=awg10; awg_auto_setup || _strategy_rc=$?; fi
      ;;
    dns)
      _dns_ok=0
      if module_preflight doh-unpoison && run_module_verified doh-unpoison; then _dns_ok=1; fi
      if [ "$_dns_ok" -eq 0 ] && module_preflight malw-hosts && run_module_verified malw-hosts; then _dns_ok=1; fi
      [ "$_dns_ok" -eq 1 ] || _strategy_rc=1
      ;;
    podkop)
      if ! module_preflight podkop; then _strategy_rc=2
      elif ! run_module_verified podkop; then _strategy_rc=$?; fi
      ;;
    proxy)
      if ! module_preflight proxy; then _strategy_rc=2
      elif ! run_module_verified proxy; then _strategy_rc=$?; fi
      ;;
    core) run_backend || _strategy_rc=$?;;
    *) _strategy_rc=2;;
  esac
  strategy_change_unlock
  return "$_strategy_rc"
}

strategy_for_class(){ case "$1" in telegram) if tggo_running 2>/dev/null; then echo tg-socks5; elif tgws_configured 2>/dev/null; then echo tg-ws; else echo core; fi;; video) echo dpi-youtube-auto;; discord) echo dpi-discord;; gaming) echo dpi-game;; social-video) echo dpi-youtube-auto;; social|ai|developer|streaming|news) echo awg-split;; *) echo core;; esac; }
strategy_fallback_for_class(){ case "$1" in telegram) if tgws_configured 2>/dev/null; then echo tg-ws; else echo core; fi;; video|social-video|discord|gaming) echo awg-split;; *) echo core;; esac; }
# Resolve a resource from the learned policy first, then fall back to the class policy.
# This keeps the decision automatic while avoiding a static one-size-fits-all mapping.
strategy_for_resource(){
  D="$1"; C="${2:-$(resource_matrix_class "$D")}";
  if [ -s "$RESOURCE_POLICY_V26" ]; then
    P="$(awk -F '\t' -v d="$D" 'NR>1&&$1==d{print $3;exit}' "$RESOURCE_POLICY_V26" 2>/dev/null)"
    [ -n "$P" ] && { printf '%s\n' "$P"; return 0; }
  fi
  strategy_for_class "$C"
}
strategy_candidates_for_class(){ case "$1" in telegram) printf '%s\n' tg-socks5 tg-ws core;; video|social-video) printf '%s\n' dpi-youtube-auto dpi awg-split awg-full;; discord) printf '%s\n' dpi-discord dpi awg-split;; gaming) printf '%s\n' dpi-game dpi awg-split;; social) printf '%s\n' dpi awg-split awg-full;; ai|developer|streaming|news) printf '%s\n' awg-split dpi awg-full;; *) printf '%s\n' core dns dpi awg-split;; esac; }

zapret_source_update(){
  mkdir -p "$ZAPRET_SOURCE_DIR" 2>/dev/null || return 1
  fetch_url(){ U="$1"; O="$2"; if have wget; then wget -q -T 12 -O "$O" "$U" 2>/dev/null; elif have curl; then curl -L -sS --connect-timeout 5 --max-time 15 -o "$O" "$U" 2>/dev/null; else return 1; fi; }
  fetch_url "$ZAPRET_STRATEGIES_URL" "$ZAPRET_STRATEGIES_FILE.tmp" || return 1
  fetch_url "$ZAPRET_YOUTUBE_STRATEGIES_URL" "$ZAPRET_YOUTUBE_FILE.tmp" || return 1
  mv "$ZAPRET_STRATEGIES_FILE.tmp" "$ZAPRET_STRATEGIES_FILE"; mv "$ZAPRET_YOUTUBE_FILE.tmp" "$ZAPRET_YOUTUBE_FILE"
  awk '/^#Yv[0-9]+/{gsub(/^#/,""); print}' "$ZAPRET_YOUTUBE_FILE" 2>/dev/null | sort -u >"$ZAPRET_SOURCE_DIR/youtube-names.lst"
  awk '/^# v[0-9]+$/{gsub(/^# /,""); print}' "$ZAPRET_STRATEGIES_FILE" 2>/dev/null | sort -u >"$ZAPRET_SOURCE_DIR/names.lst"
  date +%s >"$ZAPRET_SOURCE_DIR/updated"
  log "Zapret strategy sources updated: $ZAPRET_SOURCE_DIR"
}
zapret_source_status(){
  echo "Zapret sources: $ZAPRET_SOURCE_DIR"
  [ -s "$ZAPRET_SOURCE_DIR/updated" ] && echo "updated=$(cat "$ZAPRET_SOURCE_DIR/updated")" || echo "updated=never"
  [ -s "$ZAPRET_SOURCE_DIR/names.lst" ] && echo "generic_strategies=$(wc -l < "$ZAPRET_SOURCE_DIR/names.lst")" || echo "generic_strategies=0"
  [ -s "$ZAPRET_SOURCE_DIR/youtube-names.lst" ] && echo "youtube_strategies=$(wc -l < "$ZAPRET_SOURCE_DIR/youtube-names.lst")" || echo "youtube_strategies=0"
}

strategy_policy_init(){ mkdir -p "$(dirname "$RESOURCE_POLICY")" 2>/dev/null || true; [ -f "$RESOURCE_POLICY" ] || printf 'domain\tclass\tpreferred\tfallback\tconfidence\tlast_score\tupdated\n' >"$RESOURCE_POLICY"; }
resource_policy_plan(){
  resource_matrix_init; strategy_policy_init; resource_matrix_build_candidate "$SPEED"; OUT="$ADAPT_DIR/resource-policy.tsv"; mkdir -p "$ADAPT_DIR" 2>/dev/null || true
  printf 'domain\tclass\tpreferred\tfallback\tcandidates\tstatus\tavailability\tconfidence\tupdated\n' >"$OUT"
  # This matrix is a learned decision plan. Global backends are applied atomically;
  # it is not a promise that multiple global tunnels run simultaneously per domain.
  while IFS= read -r D; do [ -n "$D" ] || continue; C="$(resource_matrix_class "$D")"; P="$(strategy_for_resource "$D" "$C")"; F="$(strategy_fallback_for_class "$C")"; CANDS="$(strategy_candidates_for_class "$C" | tr "\n" "," | sed "s/,$//")"; S='UNKNOWN'; [ -s "$BASE/benchmark-baseline.tsv" ] && S="$(awk -F '\t' -v d="$D" 'NR>1&&$1==d{print $2;exit}' "$BASE/benchmark-baseline.tsv")"; CONF=20; case "$S" in OK) CONF=90;; SLOW_CANDIDATE) CONF=80;; HTTPS_FAIL) CONF=90;; BLOCKED_CANDIDATE) CONF=95;; esac; AV='ready'; if [ "$C" = telegram ]; then if tggo_running 2>/dev/null || tgws_configured 2>/dev/null || tg_proxy_configured 2>/dev/null; then AV='ready'; else AV='not-configured'; CONF=40; fi; fi; if [ -s "$RESOURCE_POLICY" ]; then BR="$(awk -F '\t' -v d="$D" 'NR>1&&$1==d{print $3"|"$4"|"$5"|"$6;exit}' "$RESOURCE_POLICY")"; BP="$(printf '%s' "$BR"|cut -d'|' -f1)"; BF="$(printf '%s' "$BR"|cut -d'|' -f2)"; BC="$(printf '%s' "$BR"|cut -d'|' -f3)"; BS="$(printf '%s' "$BR"|cut -d'|' -f4)"; [ -n "$BP" ] && P="$BP"; [ -n "$BF" ] && F="$BF"; [ -n "$BC" ] && CONF="$BC"; [ -n "$BS" ] && S="$BS"; fi; printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$D" "$C" "$P" "$F" "$CANDS" "$S" "$AV" "$CONF" "$(date +%s)" >>"$OUT"; done <"$RESOURCE_DIR/active.lst"
  log "Resource policy: $OUT"
}
resource_policy_status(){ [ -s "$ADAPT_DIR/resource-policy.tsv" ] && cat "$ADAPT_DIR/resource-policy.tsv" || log 'No resource policy yet'; }

resource_strategy_status(){
  resource_policy_plan >/dev/null 2>&1 || true
  printf 'Per-resource strategy matrix:\n'
  [ -s "$ADAPT_DIR/resource-policy.tsv" ] && cat "$ADAPT_DIR/resource-policy.tsv" || true
}

tg_proxy_init(){
  mkdir -p "$(dirname "$TG_PROXY_CONF")" 2>/dev/null || return 1
  [ -f "$TG_PROXY_CONF" ] || cat >"$TG_PROXY_CONF" <<'EOL'
# Telegram SOCKS5 proxy configuration
# Fill these values, then set enabled=1 and run --tg-proxy-enable
host=
port=
username=
password=
enabled=0
EOL
}
tg_proxy_load(){ tg_proxy_init; host=''; port=''; username=''; password=''; enabled=0; . "$TG_PROXY_CONF" 2>/dev/null || true; TG_HOST="$host"; TG_PORT="$port"; TG_USER="$username"; TG_PASS="$password"; TG_ENABLED="$enabled"; }
tg_proxy_configured(){ tg_proxy_load; [ "$TG_ENABLED" = 1 ] && [ -n "$TG_HOST" ] && [ -n "$TG_PORT" ]; }
tg_proxy_capability(){ tg_proxy_configured || return 1; have nft || return 1; have ip || return 1; have sing-box || { module_preflight proxy >/dev/null 2>&1 || return 1; }; have sing-box; }
json_escape(){ printf '%s' "$1" | sed 's/\\/\\\\/g;s/"/\\"/g;s/[[:space:]]/ /g'; }
nft_escape(){ printf '%s' "$1" | sed 's/\\/\\\\/g;s/"/\\"/g'; }
tg_proxy_apply(){
  tg_proxy_capability || { log 'Telegram SOCKS5 is not configured or sing-box/nft/ip is unavailable'; return 2; }
  tg_proxy_load; case "$TG_PORT" in ''|*[!0-9]*|0|[1-9]|[1-9][0-9]|[1-9][0-9][0-9][0-9][0-9]*) log 'Invalid Telegram SOCKS5 port'; return 1;; esac
  TG_HOST_JSON="$(json_escape "$TG_HOST")"; TG_USER_JSON="$(json_escape "$TG_USER")"; TG_PASS_JSON="$(json_escape "$TG_PASS")"
  mkdir -p /etc/sing-box /tmp/dnsmasq.d 2>/dev/null || return 1
  cat >"$TG_PROXY_JSON" <<EOL
{"log":{"level":"warn"},"inbounds":[{"type":"tproxy","tag":"tg-tproxy","listen":"0.0.0.0","listen_port":1101,"network":"tcp,udp","sniff":true,"sniff_override_destination":false}],"outbounds":[{"type":"socks","tag":"tg-socks5","server":"$TG_HOST_JSON","server_port":$TG_PORT$( [ -n "$TG_USER" ] && printf ',"username":"%s"' "$TG_USER_JSON" )$( [ -n "$TG_PASS" ] && printf ',"password":"%s"' "$TG_PASS_JSON" )},{"type":"direct","tag":"direct"}],"route":{"auto_detect_interface":true,"rules":[{"domain_suffix":["telegram.org","t.me","telegra.ph","telegram.me"],"outbound":"tg-socks5"},{"ip_is_private":true,"outbound":"direct"}],"final":"direct"}}
EOL
  sing-box check -c "$TG_PROXY_JSON" >/dev/null 2>&1 || { log 'sing-box Telegram config check failed'; return 1; }
  nft delete table inet universal_tg_proxy 2>/dev/null || true
  LAN_NFT="$(nft_escape "${LAN_DEV:-br-lan}")"
  case "$LAN_NFT" in ''|*[!A-Za-z0-9_.:-]*) LAN_NFT='br-lan';; esac
  cat >"$BASE/tg.nft" <<EOL
table inet universal_tg_proxy {
 set tg4 { type ipv4_addr; flags interval; }
 set tg6 { type ipv6_addr; flags interval; }
 chain prerouting { type filter hook prerouting priority mangle; policy accept; iifname "$LAN_NFT" ip daddr @tg4 meta l4proto tcp tproxy to :1101 meta mark set $TG_FWMARK; iifname "$LAN_NFT" ip daddr @tg4 meta l4proto udp tproxy to :1101 meta mark set $TG_FWMARK; iifname "$LAN_NFT" ip6 daddr @tg6 meta l4proto tcp tproxy to :1101 meta mark set $TG_FWMARK; iifname "$LAN_NFT" ip6 daddr @tg6 meta l4proto udp tproxy to :1101 meta mark set $TG_FWMARK; }
}
EOL
  nft -f "$BASE/tg.nft" >/dev/null 2>&1 || return 1
  ip rule add fwmark "$TG_FWMARK" table "$TG_TABLE" 2>/dev/null || true
  ip route add local 0.0.0.0/0 dev lo table "$TG_TABLE" 2>/dev/null || true
  if have ip6tables || have ip; then ip -6 rule add fwmark "$TG_FWMARK" table "$TG_TABLE" 2>/dev/null || true; ip -6 route add local ::/0 dev lo table "$TG_TABLE" 2>/dev/null || true; fi
  cat >"/tmp/dnsmasq.d/universal-tg-proxy.conf" <<'EOL'
nftset=/telegram.org/4#inet#universal_tg_proxy#tg4
nftset=/t.me/4#inet#universal_tg_proxy#tg4
nftset=/telegra.ph/4#inet#universal_tg_proxy#tg4
nftset=/telegram.me/4#inet#universal_tg_proxy#tg4
nftset=/telegram.org/6#inet#universal_tg_proxy#tg6
nftset=/t.me/6#inet#universal_tg_proxy#tg6
nftset=/telegra.ph/6#inet#universal_tg_proxy#tg6
nftset=/telegram.me/6#inet#universal_tg_proxy#tg6
EOL
  /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
  [ -x /etc/init.d/universal-openwrt-tg-proxy ] && /etc/init.d/universal-openwrt-tg-proxy enable >/dev/null 2>&1 || true
  [ -x /etc/init.d/universal-openwrt-tg-proxy ] && /etc/init.d/universal-openwrt-tg-proxy restart >/dev/null 2>&1 || true
  log 'Telegram -> SOCKS5 policy activated'; return 0
}
tg_proxy_disable(){ nft delete table inet universal_tg_proxy 2>/dev/null || true; ip rule del fwmark "$TG_FWMARK" table "$TG_TABLE" 2>/dev/null || true; ip route del local 0.0.0.0/0 dev lo table "$TG_TABLE" 2>/dev/null || true; ip -6 rule del fwmark "$TG_FWMARK" table "$TG_TABLE" 2>/dev/null || true; ip -6 route del local ::/0 dev lo table "$TG_TABLE" 2>/dev/null || true; rm -f /tmp/dnsmasq.d/universal-tg-proxy.conf "$TG_PROXY_JSON"; [ -x /etc/init.d/dnsmasq ] && /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true; [ -x /etc/init.d/universal-openwrt-tg-proxy ] && /etc/init.d/universal-openwrt-tg-proxy disable >/dev/null 2>&1 || true; [ -x /etc/init.d/universal-openwrt-tg-proxy ] && /etc/init.d/universal-openwrt-tg-proxy stop >/dev/null 2>&1 || true; }
# ---------- Telegram unified failover controller ----------
# TG WS is a local MTProto endpoint; it is not silently treated as a
# transparent router-wide replacement for the SOCKS5/TProxy path.
TG_FAILOVER_CONF="/etc/universal-openwrt/telegram-failover.conf"

tg_failover_init(){
  mkdir -p "$(dirname "$TG_FAILOVER_CONF")" 2>/dev/null || true
  [ -f "$TG_FAILOVER_CONF" ] || cat >"$TG_FAILOVER_CONF" <<'EOL'
# Telegram failover policy.
# mode=auto|socks5|ws|off
mode=auto
# cooldown in seconds between automatic changes
cooldown=300
EOL
}
tg_failover_load(){ tg_failover_init; mode=auto; cooldown=300; . "$TG_FAILOVER_CONF" 2>/dev/null || true; TG_FAIL_MODE="$mode"; TG_FAIL_COOLDOWN="$cooldown"; }
tg_failover_runtime_socks(){ have nft || return 1; have sing-box || return 1; nft list table inet universal_tg_proxy >/dev/null 2>&1 || return 1; [ -s "$TG_PROXY_JSON" ] || return 1; sing-box check -c "$TG_PROXY_JSON" >/dev/null 2>&1 || return 1; ps w 2>/dev/null | grep -q '[s]ing-box.*telegram-socks5.json' || return 1; return 0; }
tg_failover_active(){ if tggo_running 2>/dev/null; then echo socks5; return 0; fi; if tgws_configured && tgws_running; then echo ws; return 0; fi; if tg_failover_runtime_socks; then echo external-socks5; return 0; fi; echo none; }
tg_failover_status(){ tg_failover_load; WS_CFG=no; WS_RUN=no; SOCKS_CFG=no; SOCKS_CAP=no; SOCKS_RUN=no; EXT_CFG=no; EXT_RUN=no; tgws_configured && WS_CFG=yes || true; tgws_running && WS_RUN=yes || true; tggo_configured >/dev/null 2>&1 && SOCKS_CFG=yes || true; tggo_running >/dev/null 2>&1 && SOCKS_RUN=yes || true; tggo_installed >/dev/null 2>&1 && SOCKS_CAP=yes || true; tg_proxy_configured && EXT_CFG=yes || true; tg_failover_runtime_socks && EXT_RUN=yes || true; ACTIVE="$(tg_failover_active)"; printf 'mode=%s\ncooldown=%s\nws_configured=%s\nws_running=%s\ntg_socks5_configured=%s\ntg_socks5_runtime=%s\ntg_socks5_capable=%s\nexternal_socks5_configured=%s\nexternal_socks5_runtime=%s\nactive=%s\n' "$TG_FAIL_MODE" "$TG_FAIL_COOLDOWN" "$WS_CFG" "$WS_RUN" "$SOCKS_CFG" "$SOCKS_RUN" "$SOCKS_CAP" "$EXT_CFG" "$EXT_RUN" "$ACTIVE"; }
tg_failover_switch_socks(){
  PREV="$(tg_failover_active)"
  tgws_disable >/dev/null 2>&1 || true
  if tg_proxy_apply && tg_failover_runtime_socks; then return 0; fi
  tg_proxy_disable >/dev/null 2>&1 || true
  [ "$PREV" = ws ] && tgws_enable >/dev/null 2>&1 || true
  return 1
}
tg_failover_switch_ws(){
  PREV="$(tg_failover_active)"
  tggo_running >/dev/null 2>&1 && tggo_disable >/dev/null 2>&1 || true
  tg_proxy_disable >/dev/null 2>&1 || true
  if tgws_enable >/dev/null 2>&1 && tgws_running; then return 0; fi
  tgws_disable >/dev/null 2>&1 || true
  [ "$PREV" = socks5 ] && tg_proxy_apply >/dev/null 2>&1 || true
  return 1
}
tg_failover_switch_awg(){ echo 'Telegram AWG fallback is not enabled: no dedicated Telegram-to-AWG routing policy is implemented' >&2; return 2; }
tg_failover_apply(){ tg_failover_load; case "$TG_FAIL_MODE" in off) tg_proxy_disable >/dev/null 2>&1 || true; tgws_disable >/dev/null 2>&1 || true; tggo_disable >/dev/null 2>&1 || true; echo 'Telegram failover: disabled'; return 0;; socks5) tg_failover_switch_socks;; ws) tg_failover_switch_ws;; awg) echo 'Telegram AWG mode is unavailable without a dedicated Telegram routing policy' >&2; return 2;; auto) if tg_failover_switch_socks; then echo 'Telegram failover: local TG SOCKS5/WS bridge active'; return 0; fi; if tgws_configured && tg_failover_switch_ws; then echo 'Telegram failover: MTProto WebSocket endpoint active'; return 0; fi;  echo 'Telegram failover: no usable strategy' >&2; return 1;; *) echo "Invalid Telegram failover mode: $TG_FAIL_MODE"; return 1;; esac; }

# ---------- unified adaptive strategy controller v2 ----------
# Strategy selection is diagnosis-driven, capability-aware and cost-aware.
# Lower score is better. Reachability dominates latency, and a candidate that
# breaks control resources is rejected even if it improves one target.
ADAPT_DIR='/etc/universal-openwrt/adaptive'
ADAPT_HISTORY="$ADAPT_DIR/history.tsv"
ADAPT_STATE="$ADAPT_DIR/state"
ADAPT_LOCK='/var/run/universal-openwrt-adaptive.lock'

adaptive_init(){
  mkdir -p "$ADAPT_DIR/snapshots" "$ADAPT_DIR/cache" 2>/dev/null || return 1
  [ -f "$ADAPT_HISTORY" ] || printf 'ts\tstrategy\tphase\tscore\tblocked\thttps_fail\tslow\tok\tavg_latency\tstability\tnote\n' > "$ADAPT_HISTORY"
}
adaptive_state_get(){ adaptive_init || return 1; awk -F= -v k="$1" '$1==k{print substr($0,index($0,"=")+1);exit}' "$ADAPT_STATE" 2>/dev/null; }
adaptive_state_set(){ adaptive_init || return 1; K="$1"; V="$2"; T="$ADAPT_STATE.tmp.$$"; awk -F= -v k="$K" '$1!=k{print}' "$ADAPT_STATE" 2>/dev/null >"$T" || true; printf '%s=%s\n' "$K" "$V" >>"$T"; mv "$T" "$ADAPT_STATE"; }
adaptive_lock(){ [ -e "$ADAPT_LOCK" ] && return 1; : > "$ADAPT_LOCK"; return 0; }
adaptive_unlock(){ rm -f "$ADAPT_LOCK" 2>/dev/null || true; }
adaptive_problem_max(){ case "$SPEED" in quick) echo 5;; standard) echo 10;; deep) echo 20;; *) echo 10;; esac; }
adaptive_stability_max(){ case "$SPEED" in quick) echo 2;; standard) echo 4;; deep) echo 6;; *) echo 4;; esac; }
adaptive_strategy_cost(){ case "$1" in baseline) echo 0;; core) echo 10;; dns) echo 20;; dpi) echo 30;; awg-split) echo 45;; awg-full) echo 65;; podkop) echo 70;; proxy) echo 80;; tg-socks5) echo 25;; tg-ws) echo 28;; *) echo 100;; esac; }

adaptive_snapshot(){
  NAME="$1"; DEST="$ADAPT_DIR/snapshots/$NAME"; rm -rf "$DEST"; mkdir -p "$DEST"
  for f in network firewall dhcp system wireless podkop youtubeUnblock https-dns-proxy sing-box; do [ -f "/etc/config/$f" ] && cp -p "/etc/config/$f" "$DEST/$f"; done
  [ -d /etc/universal-openwrt/awg ] && cp -a /etc/universal-openwrt/awg "$DEST/awg" 2>/dev/null || true
  [ -f "$TGGO_CONF" ] && cp -p "$TGGO_CONF" "$DEST/tg-socks5.conf" 2>/dev/null || true
  [ -f "$TG_FAILOVER_CONF" ] && cp -p "$TG_FAILOVER_CONF" "$DEST/tg-failover.conf" 2>/dev/null || true
  printf '%s\n' "$(vpn_profile_active_get 2>/dev/null || true)" > "$DEST/active-vpn" 2>/dev/null || true
  printf '%s\n' "${VPN_MODE:-split}" > "$DEST/vpn-mode" 2>/dev/null || true
  printf '%s\n' "${AWG_IFACE:-awg10}" > "$DEST/awg-iface" 2>/dev/null || true
}
adaptive_restore(){
  NAME="$1"; DEST="$ADAPT_DIR/snapshots/$NAME"; [ -d "$DEST" ] || return 1
  for f in network firewall dhcp system wireless podkop youtubeUnblock https-dns-proxy sing-box; do [ -f "$DEST/$f" ] && cp -p "$DEST/$f" "/etc/config/$f"; done
  uci commit 2>/dev/null || true
  /etc/init.d/network reload 2>/dev/null || true
  /etc/init.d/firewall reload 2>/dev/null || true
  /etc/init.d/dnsmasq restart 2>/dev/null || true
  [ -x /etc/init.d/podkop ] && /etc/init.d/podkop restart 2>/dev/null || true
  [ -x /etc/init.d/sing-box ] && /etc/init.d/sing-box restart 2>/dev/null || true
  ACTIVE_SAVED="$(cat "$DEST/active-vpn" 2>/dev/null || true)"
  [ -n "$ACTIVE_SAVED" ] && vpn_profile_activate "$ACTIVE_SAVED" >/dev/null 2>&1 || true
}

adaptive_classify(){
  F="$1"
  AD_BLOCKED="$(awk -F '\t' 'NR>1&&$2=="BLOCKED_CANDIDATE"{n++}END{print n+0}' "$F" 2>/dev/null)"
  AD_HTTPS="$(awk -F '\t' 'NR>1&&$2=="HTTPS_FAIL"{n++}END{print n+0}' "$F" 2>/dev/null)"
  AD_SLOW="$(awk -F '\t' 'NR>1&&$2=="SLOW_CANDIDATE"{n++}END{print n+0}' "$F" 2>/dev/null)"
  AD_OK="$(awk -F '\t' 'NR>1&&$2=="OK"{n++}END{print n+0}' "$F" 2>/dev/null)"
  AD_AVG_LAT="$(awk -F '\t' 'NR>1&&$7+0>0{s+=$7;n++}END{if(n)printf "%.3f",s/n;else print 0}' "$F" 2>/dev/null)"
  export AD_BLOCKED AD_HTTPS AD_SLOW AD_OK AD_AVG_LAT
  if [ "$AD_BLOCKED" -gt 0 ]; then AD_SIGNAL='blocked';
  elif [ "$AD_HTTPS" -gt 0 ]; then AD_SIGNAL='https';
  elif [ "$AD_SLOW" -gt 0 ]; then AD_SIGNAL='slow';
  else AD_SIGNAL='healthy'; fi
}

adaptive_score_file(){
  F="$1"
  [ -s "$F" ] || { echo '999999999|0|0|0|0|0|0'; return; }
  # Status weights deliberately dominate latency:
  # blocked=1000, HTTPS failure=500, slow=100. Latency is a tie-breaker.
  awk -F '\t' '
    NR>1 {
      s=$2; if(s=="OK")w=0; else if(s=="SLOW_CANDIDATE")w=100; else if(s=="HTTPS_FAIL")w=500; else if(s=="BLOCKED_CANDIDATE")w=1000; else w=750;
      score+=w; if(s=="BLOCKED_CANDIDATE")bl++; else if(s=="HTTPS_FAIL")hf++; else if(s=="SLOW_CANDIDATE")sl++; else if(s=="OK")ok++;
      if($7+0>0){lat+=$7;nlat++}
    }
    END {avg=(nlat?lat/nlat:0); printf "%d|%d|%d|%d|%d|%.3f|%d",score,bl,hf,sl,ok,avg,NR-1}
  ' "$F"
}
adaptive_control_failures(){
  F="$1"; awk -F '\t' 'NR>1&&($1=="openwrt.org"||$1=="cloudflare.com"||$1=="google.com")&&$2!="OK"{n++}END{print n+0}' "$F" 2>/dev/null
}
adaptive_effective_score(){
  F="$1"; STRAT="$2"; R="$(adaptive_score_file "$F")"; BASE_SCORE="$(printf '%s' "$R"|cut -d'|' -f1)"; CF="$(adaptive_control_failures "$F")"; COST="$(adaptive_strategy_cost "$STRAT")";
  # Any broken control resource is a hard rejection penalty.
  PEN=$((CF*10000))
  # Small complexity penalty makes ties prefer the simplest working strategy.
  TOTAL=$((BASE_SCORE+PEN+COST))
  printf '%s|%s|%s|%s\n' "$TOTAL" "$CF" "$COST" "$R"
}
adaptive_log_result(){
  STRAT="$1"; PHASE="$2"; F="$3"; STAB="${4:-0}"; NOTE="${5:-}"
  E="$(adaptive_effective_score "$F" "$STRAT")"; SCORE="$(printf '%s' "$E"|cut -d'|' -f1)"; R="$(printf '%s' "$E"|cut -d'|' -f4)"
  BL="$(printf '%s' "$R"|cut -d'|' -f2)"; HF="$(printf '%s' "$R"|cut -d'|' -f3)"; SL="$(printf '%s' "$R"|cut -d'|' -f4)"; OK="$(printf '%s' "$R"|cut -d'|' -f5)"; LAT="$(printf '%s' "$R"|cut -d'|' -f6)"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%s)" "$STRAT" "$PHASE" "$SCORE" "$BL" "$HF" "$SL" "$OK" "$LAT" "$STAB" "$NOTE" >> "$ADAPT_HISTORY"
  printf '%s\n' "$SCORE"
}

adaptive_candidate_order(){
  SIGNAL="$1"
  case "$SIGNAL" in
    blocked) printf '%s\n' core dpi awg-split awg-full podkop proxy dns;;
    https) printf '%s\n' core dpi awg-split awg-full podkop proxy dns;;
    slow) printf '%s\n' core dns dpi awg-split awg-full podkop proxy;;
    healthy) printf '%s\n' core;;
    *) printf '%s\n' core dns dpi awg-split awg-full podkop proxy;;
  esac
}
adaptive_capability(){
  case "$1" in
    core) return 0;;
    dns) module_preflight doh-unpoison || module_preflight malw-hosts;;
    dpi|dpi-youtube-auto|dpi-discord|dpi-game) module_preflight dpi-desync;;
    awg-split|awg-full) module_preflight awg-warp;;
    podkop) module_preflight podkop;;
    proxy) module_preflight proxy;;
    tg-socks5) tggo_installed && tggo_load;; tg-ws) tgws_configured;;
    *) return 1;;
  esac
}
adaptive_apply(){
  STRAT="$1"
  case "$STRAT" in
    baseline) return 0;;
    core|dns|dpi|dpi-youtube-auto|dpi-discord|dpi-game|awg-split|awg-full|podkop|proxy|tg-socks5|tg-ws) strategy_apply "$STRAT" || return 1;;
    *) return 2;;
  esac
  sleep 1
  health >/dev/null 2>&1 || return 1
  return 0
}
adaptive_scan_candidate(){
  LABEL="$1"; MAX="$(adaptive_problem_max)"
  [ -s "$BASE/last-problematic.txt" ] || { benchmark_resources "$LABEL" >/dev/null; return; }
  scan_resource_suite "$LABEL" "$MAX" problematic
  cp -f "$RESOURCE_RESULTS" "$BASE/benchmark-$LABEL.tsv" 2>/dev/null || true
}
adaptive_stability_test(){
  STRAT="$1"; F="$BASE/benchmark-$STRAT.tsv"; [ -s "$F" ] || return 1
  MAX="$(adaptive_stability_max)"; [ -s "$BASE/last-problematic.txt" ] || return 1
  PASS=0; TOTAL=0
  while IFS= read -r D; do
    [ -n "$D" ] || continue
    [ "$TOTAL" -ge "$MAX" ] && break
    for R in 1 2; do
      T="$(http_probe_timing "https://$D/")"; C="$(printf '%s' "$T"|cut -d'|' -f1)"; TOTAL=$((TOTAL+1))
      case "$C" in 2*|3*) PASS=$((PASS+1));; esac
      [ "$TOTAL" -ge "$MAX" ] && break
    done
  done < "$BASE/last-problematic.txt"
  if [ "$TOTAL" -gt 0 ]; then STAB=$((PASS*100/TOTAL)); else STAB=0; fi
  # A stability result below 50% is a rejection signal for otherwise marginal candidates.
  printf '%s\n' "$STAB" > "$BASE/stability-$STRAT.txt"
  printf '%s\n' "$STAB"
}

adaptive_controller_run(){
  adaptive_init || return 1
  adaptive_lock || { log 'Adaptive controller already running'; return 0; }
  : > "$ADAPT_HISTORY"; printf 'ts\tstrategy\tphase\tscore\tblocked\thttps_fail\tslow\tok\tavg_latency\tstability\tnote\n' > "$ADAPT_HISTORY"
  build_resource_list
  benchmark_resources baseline >/dev/null
  adaptive_snapshot baseline
  BASE_FILE="$BASE/benchmark-baseline.tsv"
  adaptive_classify "$BASE_FILE"
  log "Strategy diagnosis: signal=$AD_SIGNAL blocked=$AD_BLOCKED https_fail=$AD_HTTPS slow=$AD_SLOW avg_latency=${AD_AVG_LAT}s"
  BASE_E="$(adaptive_effective_score "$BASE_FILE" baseline)"; BEST_SCORE="$(printf '%s' "$BASE_E"|cut -d'|' -f1)"; BEST='baseline'
  adaptive_log_result baseline baseline "$BASE_FILE" 100 'baseline' >/dev/null

  # On a healthy router, do not install expensive optional components just to benchmark them.
  if [ "$AD_SIGNAL" = healthy ]; then
    adaptive_state_set active baseline; adaptive_state_set score "$BEST_SCORE"; adaptive_state_set signal healthy; adaptive_state_set ts "$(date +%s)"
    log 'No observed resource degradation; keeping baseline and skipping optional strategies.'
    resource_policy_plan >/dev/null 2>&1 || true
    adaptive_unlock
    return 0
  fi

  for STRAT in $(adaptive_candidate_order "$AD_SIGNAL"); do
    adaptive_capability "$STRAT" || { log "strategy=$STRAT unavailable -> skip"; continue; }
    adaptive_restore baseline >/dev/null 2>&1 || true
    log "Evaluating strategy=$STRAT (signal=$AD_SIGNAL)"
    adaptive_apply "$STRAT" || { RC=$?; log "strategy=$STRAT apply failed rc=$RC -> skip"; adaptive_restore baseline >/dev/null 2>&1 || true; continue; }
    adaptive_scan_candidate "$STRAT"
    F="$BASE/benchmark-$STRAT.tsv"; [ -s "$F" ] || { adaptive_restore baseline >/dev/null 2>&1 || true; continue; }
    E="$(adaptive_effective_score "$F" "$STRAT")"; SCORE="$(printf '%s' "$E"|cut -d'|' -f1)"; CF="$(printf '%s' "$E"|cut -d'|' -f2)"; R="$(printf '%s' "$E"|cut -d'|' -f4)"; BL="$(printf '%s' "$R"|cut -d'|' -f2)"; HF="$(printf '%s' "$R"|cut -d'|' -f3)"; SL="$(printf '%s' "$R"|cut -d'|' -f4)"; LAT="$(printf '%s' "$R"|cut -d'|' -f6)"
    STAB=100
    if [ "$SCORE" -le $((BEST_SCORE+50)) ] && [ "$BL" -eq 0 ] && [ "$HF" -eq 0 ]; then STAB="$(adaptive_stability_test "$STRAT")"; fi
    NOTE='candidate'
    [ "$CF" -gt 0 ] && NOTE='control-regression'
    [ "$STAB" -lt 50 ] && NOTE='unstable'
    adaptive_log_result "$STRAT" candidate "$F" "$STAB" "$NOTE" >/dev/null
    if [ "$CF" -eq 0 ] && [ "$STAB" -ge 50 ] && [ "$SCORE" -lt "$BEST_SCORE" ]; then
      adaptive_snapshot "candidate-$STRAT"
      BEST="$STRAT"; BEST_SCORE="$SCORE"
      log "Accepted new best strategy=$BEST score=$BEST_SCORE blocked=$BL https_fail=$HF slow=$SL latency=${LAT}s stability=${STAB}%"
    else
      log "Rejected strategy=$STRAT score=$SCORE best=$BEST_SCORE control_fail=$CF stability=${STAB}%"
    fi
    adaptive_restore baseline >/dev/null 2>&1 || true
  done

  if [ "$BEST" = baseline ]; then
    adaptive_restore baseline >/dev/null 2>&1 || true
  else
    adaptive_restore "candidate-$BEST" >/dev/null 2>&1 || adaptive_restore baseline >/dev/null 2>&1 || true
  fi
  adaptive_state_set active "$BEST"
  adaptive_state_set score "$BEST_SCORE"
  adaptive_state_set signal "$AD_SIGNAL"
  adaptive_state_set ts "$(date +%s)"
  resource_policy_plan >/dev/null 2>&1 || true
  log "ADAPTIVE CONTROLLER v4: selected=$BEST score=$BEST_SCORE signal=$AD_SIGNAL resource_policy=$ADAPT_DIR/resource-policy.tsv"
  tail -n 20 "$ADAPT_HISTORY" 2>/dev/null || true
  adaptive_unlock
}
adaptive_status(){
  adaptive_init || return 1
  log "Adaptive controller v4: active=$(adaptive_state_get active) score=$(adaptive_state_get score) signal=$(adaptive_state_get signal) timestamp=$(adaptive_state_get ts)"
  [ -s "$ADAPT_HISTORY" ] && tail -n 24 "$ADAPT_HISTORY" || true
}


# ---------- per-resource strategy benchmark ----------
RESOURCE_BENCH_DIR='/etc/universal-openwrt/adaptive/resource-benchmark'
RESOURCE_BENCH_HISTORY="$RESOURCE_BENCH_DIR/history.tsv"
RESOURCE_POLICY_V26='/etc/universal-openwrt/strategy-policy.tsv'
RESOURCE_BENCH_LOCK='/var/run/universal-openwrt-resource-benchmark.lock'

resource_bench_init(){
  mkdir -p "$RESOURCE_BENCH_DIR" 2>/dev/null || return 1
  [ -f "$RESOURCE_BENCH_HISTORY" ] || printf 'ts\tdomain\tclass\tstrategy\tstatus\tscore\tcontrol_fail\tlatency\tstability\taccepted\treason\n' > "$RESOURCE_BENCH_HISTORY"
  strategy_policy_init
}
resource_bench_limit(){ case "$SPEED" in quick) echo 5;; standard) echo 15;; deep) echo 30;; *) echo 15;; esac; }
resource_bench_repeats(){ case "$SPEED" in quick) echo 1;; standard) echo 2;; deep) echo 3;; *) echo 2;; esac; }
resource_bench_status_score(){
  S="$1"; L="$2"
  case "$S" in OK) B=0;; SLOW_CANDIDATE) B=100;; HTTPS_FAIL) B=500;; BLOCKED_CANDIDATE) B=1000;; *) B=750;; esac
  case "$L" in ''|*[!0-9.]*|0) echo "$B";; *) awk -v b="$B" -v l="$L" 'BEGIN{printf "%d",b+l*10}' ;; esac
}
resource_bench_probe(){
  D="$1"; T="$2"; C="$(printf '%s' "$T"|cut -d'|' -f1)"; L="$(printf '%s' "$T"|cut -d'|' -f5)"; S='OK'; R='reachable'
  case "$C" in 2*|3*) :;; *) if probe_dns_name "$D"; then S='HTTPS_FAIL';R='dns_ok_https_fail'; else S='BLOCKED_CANDIDATE';R='dns_and_https_fail'; fi;; esac
  if [ "$S" = OK ] && [ "${BASELINE_VALID:-1}" = 1 ]; then
    if awk -v x="${L:-0}" -v th="${SLOW_THRESHOLD:-8}" 'BEGIN{exit !(x+0>=th)}'; then S='SLOW_CANDIDATE';R='latency_above_local_baseline'; fi
  fi
  printf '%s|%s|%s|%s\n' "$S" "$R" "$L" "$C"
}
resource_bench_target(){
  D="$1"; REPS="$2"; BEST='BLOCKED_CANDIDATE'; BESTS=1000; PASS=0; TOTAL=0; LATSUM=0
  I=0; while [ "$I" -lt "$REPS" ]; do
    T="$(http_probe_timing "https://$D/" 2>/dev/null || true)"; R="$(resource_bench_probe "$D" "$T")"; S="$(printf '%s' "$R"|cut -d'|' -f1)"; L="$(printf '%s' "$R"|cut -d'|' -f3)"; SC="$(resource_bench_status_score "$S" "$L")"
    [ "$SC" -lt "$BESTS" ] && BESTS="$SC" && BEST="$S"
    case "$S" in OK|SLOW_CANDIDATE) PASS=$((PASS+1));; esac
    case "$L" in ''|*[!0-9.]*) :;; *) LATSUM="$(awk -v a="$LATSUM" -v b="$L" 'BEGIN{printf "%.3f",a+b}')";; esac
    TOTAL=$((TOTAL+1)); I=$((I+1))
  done
  AVG='0'; [ "$TOTAL" -gt 0 ] && AVG="$(awk -v s="$LATSUM" -v n="$TOTAL" 'BEGIN{printf "%.3f",s/n}')"
  STAB=0; [ "$TOTAL" -gt 0 ] && STAB=$((PASS*100/TOTAL))
  printf '%s|%s|%s|%s\n' "$BEST" "$BESTS" "$AVG" "$STAB"
}
resource_bench_controls(){
  CF=0; for D in openwrt.org cloudflare.com google.com; do T="$(http_probe_timing "https://$D/" 2>/dev/null || true)"; C="$(printf '%s' "$T"|cut -d'|' -f1)"; case "$C" in 2*|3*) :;; *) CF=$((CF+1));; esac; done; echo "$CF"
}
resource_bench_update_policy(){
  D="$1"; C="$2"; P="$3"; F="$4"; SCORE="$5"; CONF="$6"; NOW="$(date +%s)"; T="$RESOURCE_POLICY_V26.tmp.$$"
  awk -F '\t' -v d="$D" 'NR==1 || $1!=d' "$RESOURCE_POLICY_V26" 2>/dev/null >"$T" || printf 'domain\tclass\tpreferred\tfallback\tconfidence\tlast_score\tupdated\n' >"$T"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$D" "$C" "$P" "$F" "$CONF" "$SCORE" "$NOW" >>"$T"
  mv "$T" "$RESOURCE_POLICY_V26"
}
resource_bench_one(){
  D="$1"; C="$(resource_matrix_class "$D")"; REPS="$(resource_bench_repeats)"; SNAP="resource-$D"; SNAP="$(printf '%s' "$SNAP"|tr '/: ' '___')"; BASESNAP="$RESOURCE_BENCH_DIR/snapshot-$SNAP"
  adaptive_snapshot "$SNAP" >/dev/null 2>&1 || true
  BASET="$(resource_bench_target "$D" "$REPS")"; BASES="$(printf '%s' "$BASET"|cut -d'|' -f2)"; BASESTAT="$(printf '%s' "$BASET"|cut -d'|' -f1)"; BASELAT="$(printf '%s' "$BASET"|cut -d'|' -f3)"
  BEST="$BASES"; BESTNAME='baseline'; BESTSTAT="$BASESTAT"; BESTLAT="$BASELAT"; BESTSTAB="$(printf '%s' "$BASET"|cut -d'|' -f4)"
  OLD_CAND="$(strategy_candidates_for_class "$C")"
  for STRAT in $OLD_CAND; do
    adaptive_capability "$STRAT" || continue
    adaptive_restore "$SNAP" >/dev/null 2>&1 || true
    adaptive_apply "$STRAT" >/dev/null 2>&1 || { adaptive_restore "$SNAP" >/dev/null 2>&1 || true; continue; }
    R="$(resource_bench_target "$D" "$REPS")"; S="$(printf '%s' "$R"|cut -d'|' -f2)"; STAT="$(printf '%s' "$R"|cut -d'|' -f1)"; LAT="$(printf '%s' "$R"|cut -d'|' -f3)"; STAB="$(printf '%s' "$R"|cut -d'|' -f4)"; CF="$(resource_bench_controls)"
    ACCEPT=0; REASON='not-better'
    if [ "$CF" -eq 0 ] && [ "$STAB" -ge 50 ] && [ "$S" -lt "$BEST" ]; then ACCEPT=1; REASON='target-improved-no-control-regression'; BEST="$S"; BESTNAME="$STRAT"; BESTSTAT="$STAT"; BESTLAT="$LAT"; BESTSTAB="$STAB"; adaptive_snapshot "resource-best-$SNAP" >/dev/null 2>&1 || true; fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%s)" "$D" "$C" "$STRAT" "$STAT" "$S" "$CF" "$LAT" "$STAB" "$ACCEPT" "$REASON" >> "$RESOURCE_BENCH_HISTORY"
    adaptive_restore "$SNAP" >/dev/null 2>&1 || true
  done
  if [ "$BESTNAME" != baseline ]; then adaptive_restore "resource-best-$SNAP" >/dev/null 2>&1 || adaptive_restore "$SNAP" >/dev/null 2>&1 || true; else adaptive_restore "$SNAP" >/dev/null 2>&1 || true; fi
  CONF=40; [ "$BESTNAME" != baseline ] && CONF=80; [ "$BESTSTAB" -ge 80 ] && CONF=$((CONF+10)); [ "$BESTSTAT" = OK ] && CONF=$((CONF+10)); [ "$CONF" -gt 100 ] && CONF=100
  FALLBACK="$(strategy_fallback_for_class "$C")"; resource_bench_update_policy "$D" "$C" "$BESTNAME" "$FALLBACK" "$BEST" "$CONF"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$D" "$C" "$BASESTAT" "$BESTNAME" "$BESTSTAT" "$BEST" "$CONF"
}
resource_benchmark_run(){
  resource_bench_init || return 1
  if [ -e "$RESOURCE_BENCH_LOCK" ]; then log 'Per-resource benchmark already running'; return 0; fi
  : >"$RESOURCE_BENCH_LOCK"; trap 'rm -f "$RESOURCE_BENCH_LOCK" 2>/dev/null || true' EXIT
  build_resource_list >/dev/null 2>&1 || return 1
  LIMIT="$(resource_bench_limit)"; SRC="$BASE/last-problematic.txt"; [ -s "$SRC" ] || SRC="$CANDIDATE_FILE"
  OUT="$RESOURCE_BENCH_DIR/latest.tsv"; printf 'domain\tclass\tbaseline_status\tbest_strategy\tbest_status\tbest_score\tconfidence\n' >"$OUT"
  N=0
  while IFS= read -r D; do
    [ -n "$D" ] || continue
    resource_bench_one "$D" >>"$OUT" 2>/dev/null || true
    N=$((N+1)); [ "$N" -ge "$LIMIT" ] && break
  done <"$SRC"
  cp -f "$OUT" "$ADAPT_DIR/resource-benchmark-latest.tsv" 2>/dev/null || true
  log "Per-resource benchmark complete: tested=$N mode=$SPEED output=$OUT"
  cat "$OUT"
}
resource_benchmark_status(){ resource_bench_init || return 1; [ -s "$RESOURCE_BENCH_DIR/latest.tsv" ] && cat "$RESOURCE_BENCH_DIR/latest.tsv" || log 'No per-resource benchmark yet'; }

# ---------- service-group benchmark / policy ----------
SERVICE_POLICY='/etc/universal-openwrt/service-policy.tsv'
SERVICE_BENCH_DIR='/etc/universal-openwrt/adaptive/service-benchmark'
SERVICE_BENCH_HISTORY="$SERVICE_BENCH_DIR/history.tsv"

service_group_for(){
  case "$1" in
    youtube.com|www.youtube.com|youtube-nocookie.com|googlevideo.com|ytimg.com|youtubei.googleapis.com|yt3.ggpht.com|yt4.ggpht.com|ggpht.com) echo youtube;;
    instagram.com|www.instagram.com|cdninstagram.com|ig.me|facebook.com|www.facebook.com|fbcdn.net|x.com|www.x.com|twitter.com|t.co|ads-twitter.com) echo social;;
    telegram.org|www.telegram.org|t.me|web.telegram.org|telegra.ph|telegram.me|telegram.dog) echo telegram;;
    discord.com|www.discord.com|discord.gg|discord.media|discordapp.com|discordapp.net) echo discord;;
    tiktok.com|www.tiktok.com|tiktokcdn.com|tiktokv.com|muscdn.com|musical.ly) echo tiktok;;
    chatgpt.com|www.chatgpt.com|openai.com|www.openai.com|oaistatic.com|oaiusercontent.com|production-openaicom-storage.azureedge.net) echo openai;;
    claude.ai|www.claude.ai|claude.com|groq.com|grok.com|grok.x.com|copilot.microsoft.com) echo ai;;
    github.com|www.github.com|githubusercontent.com|raw.githubusercontent.com|githubassets.com|npmjs.com|pypi.org) echo developer;;
    netflix.com|www.netflix.com|netflix.net|nflxvideo.net|nflximg.net|nflximg.com|nflxext.com|spotify.com|soundcloud.com|sndcdn.com|primevideo.com|hbomax.com|crunchyroll.com|deezer.com|qobuz.com) echo streaming;;
    steam.com|steampowered.com|steamcommunity.com|steamstat.info|epicgames.com|supercell.com|clashofclans.com|clashroyaleapp.com) echo gaming;;
    bbc.com|bbc.co.uk|dw.com|meduza.io|themoscowtimes.com|rferl.org|svoboda.org|radiosvoboda.org|currenttime.tv|reuters.com) echo news;;
    openwrt.org|cloudflare.com|google.com) echo control;;
