}
service_group_members(){
  G="$1"; resource_matrix_build_candidate "$SPEED" >/dev/null 2>&1 || true
  while IFS= read -r D; do [ -n "$D" ] || continue; [ "$(service_group_for "$D")" = "$G" ] && echo "$D"; done < "$RESOURCE_DIR/active.lst"
}
service_group_candidates(){
  case "$1" in
    youtube) printf '%s\n' dpi-youtube-auto dpi awg-split awg-full;;
    telegram) printf '%s\n' tg-socks5 awg-split awg-full;;
    discord) printf '%s\n' dpi-discord dpi awg-split awg-full;;
    tiktok) printf '%s\n' dpi-youtube-auto dpi awg-split awg-full;;
    social) printf '%s\n' dpi awg-split awg-full;;
    openai|ai|developer|streaming|news) printf '%s\n' awg-split dpi awg-full;;
    gaming) printf '%s\n' dpi-game dpi awg-split awg-full;;
    *) printf '%s\n' core dns dpi awg-split awg-full;;
  esac
}
service_group_weight(){ case "$1" in youtube|telegram|discord|social|tiktok|openai|ai) echo 3;; control) echo 5;; *) echo 1;; esac; }
service_policy_init(){ mkdir -p "$SERVICE_BENCH_DIR" 2>/dev/null || return 1; [ -f "$SERVICE_POLICY" ] || printf 'service\tclass\tpreferred\tfallback\tmembers\tbaseline_score\tbest_score\tconfidence\tupdated\n' > "$SERVICE_POLICY"; [ -f "$SERVICE_BENCH_HISTORY" ] || printf 'ts\tservice\tstrategy\tmember\tstatus\tscore\tcontrol_fail\taccepted\treason\n' > "$SERVICE_BENCH_HISTORY"; }
service_probe_score(){ D="$1"; T="$(http_probe_timing "https://$D/" 2>/dev/null || true)"; C="$(printf '%s' "$T"|cut -d'|' -f1)"; L="$(printf '%s' "$T"|cut -d'|' -f5)"; S=OK; case "$C" in 2*|3*) ;; *) if probe_dns_name "$D"; then S=HTTPS_FAIL; else S=BLOCKED_CANDIDATE; fi;; esac; case "$S" in OK) B=0;; SLOW_CANDIDATE) B=100;; HTTPS_FAIL) B=500;; BLOCKED_CANDIDATE) B=1000;; *) B=750;; esac; if [ -n "$L" ]; then X="$(awk -v l="$L" 'BEGIN{printf "%d",l*10}')"; else X=0; fi; printf '%s|%s|%s\n' "$S" "$((B+X))" "$L"; }
service_group_score(){ G="$1"; TOTAL=0; BAD=0; COUNT=0; while IFS= read -r D; do [ -n "$D" ] || continue; R="$(service_probe_score "$D")"; S="$(printf '%s' "$R"|cut -d'|' -f1)"; V="$(printf '%s' "$R"|cut -d'|' -f2)"; W="$(service_group_weight "$G")"; TOTAL=$((TOTAL+V*W)); [ "$S" = OK ] || BAD=$((BAD+1)); COUNT=$((COUNT+1)); done <<EOF
$(service_group_members "$G")
EOF
 [ "$COUNT" -eq 0 ] && { echo '999999|0|0'; return; }; echo "$TOTAL|$BAD|$COUNT"; }
service_control_score(){ resource_bench_controls; }
service_policy_update(){ G="$1"; C="$2"; P="$3"; F="$4"; M="$5"; BS="$6"; BEST="$7"; CONF="$8"; T="$SERVICE_POLICY.tmp.$$"; awk -F '\t' -v g="$G" 'NR==1||$1!=g' "$SERVICE_POLICY" 2>/dev/null >"$T" || printf 'service\tclass\tpreferred\tfallback\tmembers\tbaseline_score\tbest_score\tconfidence\tupdated\n' >"$T"; printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$G" "$C" "$P" "$F" "$M" "$BS" "$BEST" "$CONF" "$(date +%s)" >>"$T"; mv "$T" "$SERVICE_POLICY"; }
service_benchmark_one(){
  G="$1"; MEMBERS="$(service_group_members "$G")"; [ -n "$MEMBERS" ] || return 0; C="$G"; SNAP="service-$G"; adaptive_snapshot "$SNAP" >/dev/null 2>&1 || true; BASE="$(service_group_score "$G")"; BS="$(printf '%s' "$BASE"|cut -d'|' -f1)"; BEST="$BS"; BESTNAME=baseline; BESTBAD="$(printf '%s' "$BASE"|cut -d'|' -f2)"; 
  for STRAT in $(service_group_candidates "$G"); do
    adaptive_capability "$STRAT" || continue; adaptive_restore "$SNAP" >/dev/null 2>&1 || true; adaptive_apply "$STRAT" >/dev/null 2>&1 || { adaptive_restore "$SNAP" >/dev/null 2>&1 || true; continue; }; R="$(service_group_score "$G")"; S="$(printf '%s' "$R"|cut -d'|' -f1)"; BAD="$(printf '%s' "$R"|cut -d'|' -f2)"; CF="$(service_control_score)"; ACC=0; REASON=not-better; [ "$CF" -eq 0 ] && [ "$BAD" -le "$BESTBAD" ] && [ "$S" -lt "$BEST" ] && { ACC=1; REASON=service-improved; BEST="$S"; BESTNAME="$STRAT"; BESTBAD="$BAD"; adaptive_snapshot "service-best-$SNAP" >/dev/null 2>&1 || true; }; while IFS= read -r D; do [ -n "$D" ] || continue; RR="$(service_probe_score "$D")"; printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%s)" "$G" "$STRAT" "$D" "$(printf '%s' "$RR"|cut -d'|' -f1)" "$(printf '%s' "$RR"|cut -d'|' -f2)" "$CF" "$ACC" "$REASON" >>"$SERVICE_BENCH_HISTORY"; done <<EOF
$MEMBERS
EOF
    adaptive_restore "$SNAP" >/dev/null 2>&1 || true
  done
  if [ "$BESTNAME" != baseline ]; then adaptive_restore "service-best-$SNAP" >/dev/null 2>&1 || adaptive_restore "$SNAP" >/dev/null 2>&1 || true; else adaptive_restore "$SNAP" >/dev/null 2>&1 || true; fi
  CONF=50; [ "$BESTNAME" != baseline ] && CONF=80; [ "$BESTBAD" -eq 0 ] && CONF=$((CONF+10)); [ "$CONF" -gt 100 ] && CONF=100; FALLBACK="$(strategy_fallback_for_class "$G")"; [ "$G" = youtube ] && FALLBACK=awg-split; [ "$G" = telegram ] && FALLBACK=core; service_policy_update "$G" "$C" "$BESTNAME" "$FALLBACK" "$(printf '%s\n' "$MEMBERS"|tr '\n' ', '|sed 's/, $//')" "$BS" "$BEST" "$CONF"; printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$G" "$BS" "$BESTNAME" "$BESTBAD" "$BEST" "$CONF"; }
service_benchmark_run(){ service_policy_init || return 1; build_resource_list >/dev/null 2>&1 || true; case "$SPEED" in quick) GS='youtube telegram social';; standard) GS='youtube telegram social discord openai developer streaming';; deep) GS='youtube telegram social discord tiktok openai ai developer streaming gaming news';; *) GS='youtube telegram social discord';; esac; OUT="$SERVICE_BENCH_DIR/latest.tsv"; printf 'service\tbaseline_score\tbest_strategy\tbad_members\tbest_score\tconfidence\n' >"$OUT"; for G in $GS; do service_benchmark_one "$G" >>"$OUT" 2>/dev/null || true; done; cp -f "$OUT" "$ADAPT_DIR/service-benchmark-latest.tsv" 2>/dev/null || true; log "Service-group benchmark complete: $OUT"; cat "$OUT"; }
service_benchmark_status(){ service_policy_init || return 1; [ -s "$SERVICE_BENCH_DIR/latest.tsv" ] && cat "$SERVICE_BENCH_DIR/latest.tsv" || log 'No service-group benchmark yet'; }
service_policy_status(){ service_policy_init || return 1; cat "$SERVICE_POLICY"; }

# ---------- predictive adaptive controller ----------
PRED_DIR='/etc/universal-openwrt/predictive'
PRED_HISTORY="$PRED_DIR/resource-history.tsv"
PRED_STATE="$PRED_DIR/state"
PRED_LOCK='/var/run/universal-openwrt-predictive.lock'
predictive_init(){ mkdir -p "$PRED_DIR" "$PRED_DIR/cache" 2>/dev/null || return 1; [ -f "$PRED_HISTORY" ] || printf 'ts\tdomain\tstatus\ttotal_s\treason\tstrategy\tmode\n' > "$PRED_HISTORY"; }
predictive_state_get(){ predictive_init || return 1; awk -F= -v k="$1" '$1==k{print substr($0,index($0,"=")+1);exit}' "$PRED_STATE" 2>/dev/null; }
predictive_state_set(){ predictive_init || return 1; K="$1"; V="$2"; T="$PRED_STATE.tmp.$$"; awk -F= -v k="$K" '$1!=k{print}' "$PRED_STATE" 2>/dev/null >"$T" || true; printf '%s=%s\n' "$K" "$V" >>"$T"; mv "$T" "$PRED_STATE"; }
predictive_lock(){ [ -e "$PRED_LOCK" ] && return 1; : > "$PRED_LOCK"; trap 'rm -f "$PRED_LOCK" 2>/dev/null || true' EXIT; return 0; }
predictive_limit(){ case "$SPEED" in quick) echo 8;; standard) echo 20;; deep) echo 40;; *) echo 20;; esac; }
predictive_record_file(){ FILE="$1"; STRAT="${2:-current}"; MODE="${3:-$SPEED}"; TS="$(date +%s)"; [ -s "$FILE" ] || return 0; awk -F '\t' -v ts="$TS" -v strat="$STRAT" -v mode="$MODE" 'NR>1&&NF>=7{print ts"\t"$1"\t"$2"\t"$7"\t"$3"\t"strat"\t"mode}' "$FILE" >> "$PRED_HISTORY"; }
predictive_domain_score(){ D="$1"; awk -F '\t' -v d="$D" 'NR>1&&$2==d{n++;if($3=="OK")ok++;if($3=="SLOW_CANDIDATE")slow++;if($3=="HTTPS_FAIL")hf++;if($3=="BLOCKED_CANDIDATE")bl++;if($4+0>0){sum+=$4;nlat++}}END{if(n==0){print "0|0|0|0|0|0";exit}print n"|"ok"|"slow"|"hf"|"bl"|"(nlat?sum/nlat:99)}' "$PRED_HISTORY"; }
predictive_strategy_hint(){ D="$1"; R="$(predictive_domain_score "$D")"; OK="$(printf '%s' "$R"|cut -d'|' -f2)"; SLOW="$(printf '%s' "$R"|cut -d'|' -f3)"; HF="$(printf '%s' "$R"|cut -d'|' -f4)"; BL="$(printf '%s' "$R"|cut -d'|' -f5)"; if [ "${BL:-0}" -gt 0 ];then echo vpn_or_dpi;elif [ "${HF:-0}" -gt 0 ];then echo https_or_dpi;elif [ "${SLOW:-0}" -gt 0 ];then echo latency_or_route;else echo healthy;fi; }
predictive_build_plan(){ predictive_init || return 1; PLAN="$PRED_DIR/plan.tsv"; : > "$PLAN"; printf 'domain\thint\tpriority\n' > "$PLAN"; SRC="$BASE/last-problematic.txt"; [ -s "$SRC" ] || SRC="$CANDIDATE_FILE"; N=0; LIMIT="$(predictive_limit)"; while IFS= read -r D;do [ -n "$D" ]||continue;H="$(predictive_strategy_hint "$D")";case "$H" in vpn_or_dpi)P=3;;https_or_dpi)P=2;;latency_or_route)P=1;;*)P=0;;esac;printf '%s\t%s\t%s\n' "$D" "$H" "$P" >> "$PLAN";N=$((N+1));[ "$N" -ge "$LIMIT" ]&&break;done < "$SRC"; sort -t $'\t' -k3,3nr "$PLAN" > "$PLAN.tmp" 2>/dev/null && mv "$PLAN.tmp" "$PLAN" || true; predictive_state_set plan_ts "$(date +%s)"; log "Predictive plan built: $N resources"; }
predictive_status(){ predictive_init || return 1; log "Predictive controller: active=$(predictive_state_get active) reason=$(predictive_state_get reason) ts=$(predictive_state_get ts)"; [ -s "$PRED_HISTORY" ]&&tail -n 20 "$PRED_HISTORY"||true; }
predictive_auto(){ predictive_init || return 1; predictive_lock || { log 'Predictive controller already running'; return 0; };build_resource_list;[ -s "$BASE/last-problematic.txt" ]||benchmark_resources baseline >/dev/null 2>&1;predictive_record_file "$BASE/benchmark-baseline.tsv" baseline "$SPEED";predictive_build_plan;[ -s "$PRED_DIR/plan.tsv" ] || { log 'No predictive plan'; return 1; };NOW="$(date +%s)";LAST="$(predictive_state_get ts)";case "$LAST" in ''|*[!0-9]*)LAST=0;;esac;if [ $((NOW-LAST)) -lt 300 ]&&[ -n "$(predictive_state_get active)" ];then log 'Predictive decision cached for 5 minutes';return 0;fi;adaptive_controller_run >/dev/null 2>&1||true;ACTIVE="$(adaptive_state_get active 2>/dev/null || echo baseline)";REASON='mixed';grep -q 'vpn_or_dpi' "$PRED_DIR/plan.tsv" 2>/dev/null&&REASON='vpn_or_dpi';[ "$REASON" = mixed ]&&grep -q 'https_or_dpi' "$PRED_DIR/plan.tsv" 2>/dev/null&&REASON='https_or_dpi';predictive_state_set active "$ACTIVE";predictive_state_set reason "$REASON";predictive_state_set ts "$NOW";log "PREDICTIVE CONTROLLER: active=$ACTIVE reason=$REASON"; }

# ---------- compatibility matrix ----------
probe_pkg(){
  case "$PM" in
    apk) apk info "$1" >/dev/null 2>&1 || apk search -e "$1" >/dev/null 2>&1 ;;
    opkg) opkg status "$1" >/dev/null 2>&1 || opkg list 2>/dev/null | grep -q "^$1[[:space:]]" ;;
    *) return 1;;
  esac
}

matrix(){
  detect
  printf '\nCompatibility matrix\n'
  printf '  %-18s %s\n' 'Core UCI/DNS' 'PASS'
  if [ -n "$DNSMASQ" ] && [ -r /etc/config/dhcp ]; then
    printf '  %-18s %s\n' 'DoH/dnsmasq' 'PASS'
  else
    printf '  %-18s %s\n' 'DoH/dnsmasq' 'SKIP'
  fi
  if [ "$FW" = fw4 ]; then
    printf '  %-18s %s\n' 'QUIC firewall' 'PASS'
  else
    printf '  %-18s %s\n' 'QUIC firewall' 'SKIP'
  fi
  if command -v wg >/dev/null 2>&1 || probe_pkg wireguard-tools; then
    printf '  %-18s %s\n' 'WireGuard tools' 'PASS'
  else
    printf '  %-18s %s\n' 'WireGuard tools' 'OPTIONAL'
  fi
  if [ -e /sys/module/amneziawg ] && { [ -e /dev/net/tun ] || [ "$WG" = 1 ]; }; then
    printf '  %-18s %s\n' 'AmneziaWG' 'KERNEL READY'
  elif command -v awg >/dev/null 2>&1 || command -v awg-quick >/dev/null 2>&1; then
    printf '  %-18s %s\n' 'AmneziaWG' 'TOOLS ONLY'
  else
    printf '  %-18s %s\n' 'AmneziaWG' 'NOT DETECTED'
  fi
  if [ "$IMMUTABLE" = 1 ]; then
    printf '  %-18s %s\n' 'Immutable root' 'SAFE MODE'
  else
    printf '  %-18s %s\n' 'Writable root' 'PASS'
  fi
  printf '  %-18s %s\n' 'OpenWrt' "$VERSION_OW"
  printf '  %-18s %s\n' 'Package manager' "$PM"
  printf '  %-18s %s\n' 'Firewall' "$FW"
  printf '  %-18s %s\n' 'LAN/WAN' "$LAN_DEV / $WAN_DEV"
  printf '\n'
}

# ---------- verification / regression tests ----------
TEST_DOMAINS="openwrt.org github.com"
TEST_URLS="https://openwrt.org/ https://github.com/"
BASELINE_FILE="$BASE/baseline.txt"

measure_ping(){
  H="$1"
  if have ping; then ping -c 2 -W 2 "$H" 2>/dev/null | awk -F'/' '/rtt|round-trip/{print $5; exit}' || true; fi
}

collect_snapshot(){
  OUT="$1"
  {
    echo "timestamp=$(date '+%F %T' 2>/dev/null || true)"
    echo "default=$(ip route 2>/dev/null | awk '/^default /{print; exit}')"
    echo "dns_openwrt=$(probe_dns_name openwrt.org; echo $?)"
    echo "dns_github=$(probe_dns_name github.com; echo $?)"
    echo "https_openwrt=$(probe_https https://openwrt.org/; echo $?)"
    echo "https_github=$(probe_https https://github.com/; echo $?)"
    echo "ping_openwrt=$(measure_ping openwrt.org)"
    echo "ping_github=$(measure_ping github.com)"
  } > "$OUT"
}

verify_regression(){
  BEFORE="$1"; AFTER="$2"
  log 'Regression comparison:'
  [ -f "$BEFORE" ] && cat "$BEFORE" | tee -a "$LOG" >/dev/null || true
  log '--- after ---'
  [ -f "$AFTER" ] && cat "$AFTER" | tee -a "$LOG" >/dev/null || true
  B_BAD=0; A_BAD=0
  if [ -f "$BEFORE" ]; then grep -q 'dns_openwrt=0' "$BEFORE" || B_BAD=1; grep -q 'https_openwrt=0' "$BEFORE" || B_BAD=1; fi
  if [ -f "$AFTER" ]; then grep -q 'dns_openwrt=0' "$AFTER" || A_BAD=1; grep -q 'https_openwrt=0' "$AFTER" || A_BAD=1; fi
  if [ "$B_BAD" = 0 ] && [ "$A_BAD" = 1 ]; then
    log 'REGRESSION=FAIL (baseline healthy, post-change connectivity degraded)'
    return 1
  fi
  log 'REGRESSION=PASS/INCONCLUSIVE'
  return 0
}

rpc_smoke(){
  have ubus || { log 'RPC_SMOKE=SKIP (ubus missing)'; return 0; }
  have jsonfilter || { log 'RPC_SMOKE=SKIP (jsonfilter missing)'; return 0; }
  METHODS="version status verify self_check awg_status vpn_profiles vpn_monitor_status adaptive_status predictive_status device_status service_policy tg_proxy_status tg_ws_status tg_socks5_status tg_failover_status strategy_plan strategy_status tunnel_status tunnel_profiles"
  FAIL=0
  for M in $METHODS; do
    OUT="$(ubus call universal_openwrt "$M" '{}' 2>&1)" || { log "RPC $M: FAIL (ubus)"; FAIL=1; continue; }
    OK="$(printf '%s' "$OUT" | jsonfilter -e '@.ok' 2>/dev/null || true)"
    if [ "$OK" = true ]; then log "RPC $M: PASS"; else log "RPC $M: PASS (legacy/read-only response)"; fi
    printf '%s' "$OUT" | grep -Eiq 'not found|parameter not set|reference error|object not found|internal server error' && { log "RPC $M: FAIL (backend error text)"; FAIL=1; } || true
  done
  [ "$FAIL" = 0 ] && { log 'RPC_SMOKE=PASS'; return 0; }
  log 'RPC_SMOKE=FAIL'; return 1
}

verify(){
  detect
  mkdir -p "$BASE"
  log 'Verification test suite:'
  collect_snapshot "$BASE/verify.txt"
  cat "$BASE/verify.txt" | tee -a "$LOG" >/dev/null
  if grep -q 'dns_openwrt=0' "$BASE/verify.txt" && grep -q 'https_openwrt=0' "$BASE/verify.txt"; then
    log 'VERIFY=PASS'
    return 0
  fi
  log 'VERIFY=DEGRADED'
  return 1
}

# Run a before/after connectivity gate around a potentially disruptive module.
run_module_verified(){
  NAME="$1"; shift
  collect_snapshot "$BASE/before-$NAME.txt"
  if ! run_module "$NAME" "$@"; then return 1; fi
  collect_snapshot "$BASE/after-$NAME.txt"
  verify_regression "$BASE/before-$NAME.txt" "$BASE/after-$NAME.txt" || {
    log "Connectivity regression after $NAME; restoring module snapshot"
    module_restore
    return 1
  }
  return 0
}

# ---------- health ----------
health(){
  detect
  log 'Health check:'
  OK=1
  for f in /etc/config/network /etc/config/firewall /etc/config/dhcp; do
    [ -r "$f" ] && log "  OK config $f" || { log "  WARN missing $f"; OK=0; }
  done
  if have uci; then
    uci show network >/dev/null 2>&1 && log '  OK UCI network parses' || OK=0
    uci show firewall >/dev/null 2>&1 && log '  OK UCI firewall parses' || OK=0
    uci show dhcp >/dev/null 2>&1 && log '  OK UCI dhcp parses' || OK=0
  fi
  if ip route 2>/dev/null | grep -q '^default '; then log '  OK default route'; else log '  WARN no default route'; OK=0; fi
  if nslookup openwrt.org 127.0.0.1 >/dev/null 2>&1; then log '  OK local DNS'; else log '  WARN local DNS test failed'; fi
  [ "$OK" = 1 ] && log 'HEALTH=PASS' || log 'HEALTH=DEGRADED'
}

rollback(){
  [ -f "$BACKUP_BASE/LATEST" ] || die 'no backup found'
  DEST="$(cat "$BACKUP_BASE/LATEST")"
  [ -d "$DEST" ] || die "backup missing: $DEST"
  log "Rollback from $DEST"
  if [ -f "$DEST/sysupgrade.tar.gz" ] && have sysupgrade; then
    sysupgrade -r "$DEST/sysupgrade.tar.gz"; exit $?
  fi
  for f in network firewall dhcp system wireless podkop youtubeUnblock https-dns-proxy sing-box; do
    [ -f "$DEST/$f" ] && cp -p "$DEST/$f" "/etc/config/$f"
  done
  uci commit 2>/dev/null || true
  /etc/init.d/network reload 2>/dev/null || true
  /etc/init.d/firewall reload 2>/dev/null || true
  /etc/init.d/dnsmasq restart 2>/dev/null || true
  log 'Rollback complete'
}

install_luci(){
  SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
  [ -x "$SCRIPT_DIR/install-luci.sh" ] || die 'install-luci.sh not found next to this script'
  log 'Installing LuCI application'
  "$SCRIPT_DIR/install-luci.sh"
}

# ---------- device-aware benchmark ----------
DEVICE_DIR='/etc/universal-openwrt/device-aware'
DEVICE_CLIENTS="$DEVICE_DIR/clients.tsv"
DEVICE_POLICY="$DEVICE_DIR/policy.tsv"
DEVICE_HISTORY="$DEVICE_DIR/history.tsv"
DEVICE_CONF="$DEVICE_DIR/config"

device_init(){
  mkdir -p "$DEVICE_DIR" 2>/dev/null || true
  [ -f "$DEVICE_CONF" ] || {
    printf '%s\n' 'enabled=1' 'auto_profile=1' 'probe_count=2' 'confidence_threshold=60' 'manual_profiles_allowed=1' >"$DEVICE_CONF"
  }
  [ -f "$DEVICE_CLIENTS" ] || printf 'ip\tmac\thostname\tprofile\tsource\tconfidence\tupdated\n' >"$DEVICE_CLIENTS"
  [ -f "$DEVICE_POLICY" ] || printf 'ip\tmac\tprofile\tservice\tstrategy\tfallback\tconfidence\tupdated\n' >"$DEVICE_POLICY"
  [ -f "$DEVICE_HISTORY" ] || printf 'ts\tip\tmac\tprofile\tservice\tstrategy\tscore\tresult\n' >"$DEVICE_HISTORY"
}

device_cfg(){ grep -E "^$1=" "$DEVICE_CONF" 2>/dev/null | tail -1 | cut -d= -f2-; }

device_profile_from_text(){
  T="$(printf '%s %s' "$1" "$2" | tr '[:upper:]' '[:lower:]')"
  case "$T" in
    *iphone*|*ipad*|*ios*|*apple*) echo ios;;
    *android*|*samsung*|*xiaomi*|*redmi*|*pixel*|*oneplus*|*huawei*|*honor*) echo android;;
    *windows*|*win10*|*win11*) echo windows;;
    *playstation*|*xbox*|*steamdeck*|*nintendo*|*switch*) echo gaming;;
    *android_tv*|*google_tv*|*chromecast*|*firetv*|*tizen*|*webos*|*smart*tv*) echo tv;;
    *) echo generic;;
  esac
}

device_discover(){
  device_init
  TMP="/tmp/uow-device-clients.$$"
  : >"$TMP"
  if command -v ubus >/dev/null 2>&1; then
    ubus call dhcp ipv4leases 2>/dev/null | tr '{},"' ' ' | sed 's/:/ /g' | awk '
      /ip/ {ip=$2} /mac/ {mac=$2} /hostname/ {h=$2; if(ip!="" && mac!="") {print ip "\t" mac "\t" h; ip="";mac="";h=""}}' >>"$TMP" 2>/dev/null || true
  fi
  if [ ! -s "$TMP" ] && [ -f /tmp/dhcp.leases ]; then
    awk '{print $3 "\t" $2 "\t" $4}' /tmp/dhcp.leases >>"$TMP" 2>/dev/null || true
  fi
  NOW="$(date +%s)"
  while IFS="$(printf '\t')" read -r IP MAC HOST; do
    [ -n "$IP" ] || continue
    [ -n "$MAC" ] || continue
    OLD="$(awk -F '\t' -v i="$IP" '$1==i{print;exit}' "$DEVICE_CLIENTS" 2>/dev/null)"
    MAN="$(printf '%s\n' "$OLD" | awk -F '\t' '{print $4}')"
    if [ -n "$MAN" ] && [ "$MAN" != generic ] && [ "$MAN" != auto ]; then PROF="$MAN"; SRC=manual; CONF=100
    else PROF="$(device_profile_from_text "$HOST" "$MAC")"; SRC=inferred; CONF=40; case "$PROF" in generic) CONF=20;; *) CONF=60;; esac; fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$IP" "$MAC" "$HOST" "$PROF" "$SRC" "$CONF" "$NOW" >>"$DEVICE_CLIENTS.new"
  done <"$TMP"
  if [ -s "$DEVICE_CLIENTS.new" ]; then { head -n1 "$DEVICE_CLIENTS"; cat "$DEVICE_CLIENTS.new"; } | awk -F '\t' '!seen[$1]++' >"$DEVICE_CLIENTS.tmp"; mv "$DEVICE_CLIENTS.tmp" "$DEVICE_CLIENTS"; rm -f "$DEVICE_CLIENTS.new"; fi
  rm -f "$TMP"
  log "Device inventory updated: $DEVICE_CLIENTS"
}

device_candidates(){
  case "$1" in
    ios) echo 'dpi-youtube-auto dpi awg-split tg-socks5 awg-full';;
    android) echo 'dpi-youtube-auto dpi awg-split tg-socks5 awg-full';;
    windows) echo 'dpi-youtube-auto dpi-discord dpi awg-split awg-full proxy';;
    tv) echo 'dpi-youtube-auto awg-split awg-full dpi';;
    gaming) echo 'dpi-discord dpi awg-split awg-full';;
    *) echo 'dpi-youtube-auto dpi awg-split awg-full podkop proxy';;
  esac
}

device_service_for_profile(){
  case "$1" in
    telegram) echo tg-socks5;;
    youtube) echo dpi-youtube-auto;;
    discord) echo dpi-discord;;
    *) echo dpi;;
  esac
}

device_benchmark_one(){
  IP="$1"; MAC="$2"; PROF="$3"; SERVICE="$4"; NOW="$(date +%s)"
  CANDS="$(device_candidates "$PROF")"
  BEST=999999; BESTNAME=direct; BESTRES=unknown
  for S in $CANDS; do
    # Device-aware mode is policy selection: actual network strategy is benchmarked at router/service level,
    # while device compatibility is recorded separately. This avoids falsely claiming router-side probes emulate an endpoint OS.
    SCORE=999999; RES=not-tested
    case "$SERVICE" in
      youtube) grep -q '^youtube' "$ADAPT_DIR/service-benchmark-latest.tsv" 2>/dev/null && SCORE=50 || SCORE=500;;
      telegram) [ "$S" = tg-socks5 ] && SCORE=10 || SCORE=300;;
      discord) [ "$S" = dpi-discord ] && SCORE=20 || SCORE=200;;
      *) SCORE=100;;
    esac
    case "$PROF" in tv) [ "$SERVICE" = youtube ] && [ "$S" = dpi-youtube-auto ] && SCORE=$((SCORE-10));; ios|android) [ "$SERVICE" = youtube ] && [ "$S" = awg-split ] && SCORE=$((SCORE-5));; esac
    [ "$SCORE" -lt "$BEST" ] && { BEST="$SCORE"; BESTNAME="$S"; BESTRES="$RES"; }
  done
  CONF=40; [ "$PROF" != generic ] && CONF=65; [ "$SERVICE" = telegram ] && [ "$BESTNAME" = tg-socks5 ] && CONF=90
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$IP" "$MAC" "$PROF" "$SERVICE" "$BESTNAME" "$CONF" "$NOW" >>"$DEVICE_POLICY"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$NOW" "$IP" "$MAC" "$PROF" "$SERVICE" "$BESTNAME" "$BEST" "$BESTRES" >>"$DEVICE_HISTORY"
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$IP" "$PROF" "$SERVICE" "$BESTNAME" "$CONF" "$BEST"
}

device_benchmark(){
  device_init; device_discover
  [ -s "$DEVICE_CLIENTS" ] || { log 'No DHCP clients discovered'; return 0; }
  : >"$DEVICE_POLICY.tmp"
  head -n1 "$DEVICE_POLICY" >"$DEVICE_POLICY.tmp"
  while IFS="$(printf '\t')" read -r IP MAC HOST PROF SRC CONF UPDATED; do
    [ "$IP" = ip ] && continue
    [ -n "$IP" ] || continue
    for SERVICE in youtube telegram discord; do
      device_benchmark_one "$IP" "$MAC" "$PROF" "$SERVICE" >/dev/null 2>&1 || true
    done
  done <"$DEVICE_CLIENTS"
  awk -F '\t' '!seen[$1 FS $4]++' "$DEVICE_POLICY" >>"$DEVICE_POLICY.tmp" 2>/dev/null || true
  mv "$DEVICE_POLICY.tmp" "$DEVICE_POLICY"
  log "Device-aware benchmark complete: $DEVICE_POLICY"
  cat "$DEVICE_POLICY"
}

device_status(){
  device_init; echo '=== DEVICE-AWARE STATUS ==='; echo "config=$DEVICE_CONF"; echo "clients=$DEVICE_CLIENTS"; echo "policy=$DEVICE_POLICY"; echo '--- clients ---'; cat "$DEVICE_CLIENTS" 2>/dev/null; echo '--- policy ---'; cat "$DEVICE_POLICY" 2>/dev/null; }

device_set_profile(){
  device_init; IP="$1"; PROF="$2"; [ -n "$IP" ] && [ -n "$PROF" ] || return 2
  awk -F '\t' -v ip="$IP" -v p="$PROF" 'BEGIN{OFS="\t"} NR==1{print;next} $1==ip{$4=p;$5="manual";$6=100} {print}' "$DEVICE_CLIENTS" >"$DEVICE_CLIENTS.tmp" && mv "$DEVICE_CLIENTS.tmp" "$DEVICE_CLIENTS"
}

