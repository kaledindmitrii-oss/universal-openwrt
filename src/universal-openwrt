  tunnel_profile_delete) te_profile_delete "$TUNNEL_NAME"; exit $?;;
  tunnel_enable) te_enable "$TUNNEL_NAME"; exit $?;;
  tunnel_disable) te_disable; exit 0;;
  tunnel_auto) te_auto_select; exit $?;;
  *) log "Universal OpenWrt v$VERSION (speed=$SPEED)";;
esac
case "$MODE" in
  self_check)
    detect
    require_supported_platform
    printf 'version=%s\npackage_manager=%s\nfirewall=%s\narch=%s\nkernel=%s\nram_kb=%s\nfree_root_kb=%s\n' "$VERSION" "$PM" "$FW" "$ARCH" "$KERNEL" "$RAM_KB" "$FREE_KB"
    for x in uci ubus jsonfilter ip awk sed grep; do have "$x" && printf 'tool.%s=ok\n' "$x" || printf 'tool.%s=missing\n' "$x"; done
    exit 0;;
  install_luci) install_luci; exit 0;;
  rollback) rollback;;
  *) detect; require_supported_platform; show; plan;;
esac

awg_auto(){ VPN_MODE=split; AWG_IFACE=awg10; awg_auto_setup; }

case "$MODE" in
