  --dry-run      do not change anything
  --install      backup + install selected backend/modules + health check
  --backend-url URL      opt-in external backend archive URL (requires SHA256)
  --backend-sha256 HASH  SHA256 for the opt-in external backend archive
  --health       run health check
  --autotest     run baseline/runtime connectivity tests only
  --verify       run connectivity + regression verification suite
  --rpc-smoke    run safe read-only ubus RPC contract smoke tests
  --optimize     calculate adaptive profile/module policy without changes
  --discover     build and measure automatic blocked/slow resource list
  --benchmark    benchmark reachable resources and strategy candidates
  --rollback     restore latest UCI/sysupgrade backup
  --install-luci install the bundled LuCI interface
  --profile NAME auto|minimal|dns|full
  --module NAME auto|core|doh-unpoison|malw-hosts|dpi-desync|awg-warp|podkop|proxy|all
