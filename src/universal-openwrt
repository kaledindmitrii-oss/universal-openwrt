    --vpn-monitor-enable) MODE=vpn_monitor_enable;;
    --vpn-monitor-disable) MODE=vpn_monitor_disable;;
    --vpn-monitor-run) MODE=vpn_monitor_run;;
    --adaptive-auto) MODE=adaptive_auto;;
    --adaptive-status) MODE=adaptive_status;;
