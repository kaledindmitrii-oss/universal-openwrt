    --resource-update) MODE=resource_update;;
    --resource-strategy-status) MODE=resource_strategy_status;;
    --resource-benchmark) MODE=resource_benchmark;;
    --resource-benchmark-status) MODE=resource_benchmark_status;;
    --service-benchmark) MODE=service_benchmark;;
    --service-benchmark-status) MODE=service_benchmark_status;;
    --service-policy-status) MODE=service_policy_status;;
    --zapret-sources-update) MODE=zapret_sources_update;;
