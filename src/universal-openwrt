  --service-benchmark      benchmark service groups
  --service-benchmark-status show latest service-group benchmark results
  --service-policy-status   show service policy
  --zapret-sources-update refresh StressOzz Zapret/YouTube strategy sources
  --zapret-strategy-status show imported Zapret strategy source status
  --tg-proxy-status      show Telegram external SOCKS5 policy status
  --tg-proxy-enable      activate Telegram -> external SOCKS5 policy from config
  --tg-proxy-disable     disable Telegram external SOCKS5 policy
  --tg-socks5-status     show local TG SOCKS5/WS bridge status
  --tg-socks5-install    install/update local TG SOCKS5/WS bridge
  --tg-socks5-enable     enable local TG SOCKS5/WS bridge
  --tg-socks5-disable    disable local TG SOCKS5/WS bridge
  --tg-ws-status        show Telegram MTProto WebSocket backend status
  --tg-ws-enable        start Telegram MTProto WebSocket backend
  --tg-ws-disable       stop Telegram MTProto WebSocket backend
  --tg-failover-status   show unified Telegram failover state
