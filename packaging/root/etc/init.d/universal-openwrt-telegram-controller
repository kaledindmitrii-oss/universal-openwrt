#!/bin/sh /etc/rc.common
START=99
STOP=06
USE_PROCD=1

start_service(){
  . /usr/lib/universal-openwrt/telegram-controller.sh 2>/dev/null || return 0
  telegram_controller_load || return 0
  [ "$TGCTL_ENABLED" = 1 ] || return 0
  procd_open_instance
  procd_set_param command /bin/sh -c 'while :; do /usr/sbin/universal-openwrt --telegram-controller-run >/dev/null 2>&1 || true; sleep "${TGCTL_INTERVAL:-15}"; done'
  procd_set_param respawn 3600 5 5
  procd_close_instance
}
