#!/bin/sh /etc/rc.common
START=97
STOP=08
USE_PROCD=1
NAME=universal-openwrt-tg-ws

start_service(){
  [ -f /etc/universal-openwrt/telegram-ws.conf ] || return 0
  . /usr/lib/universal-openwrt/tg-ws-proxy.sh 2>/dev/null || return 0
  tgws_load || return 0
  [ "$TGWS_ENABLED" = 1 ] || return 0
  BIN="$(tgws_find_bin 2>/dev/null || true)"
  [ -n "$BIN" ] || return 0
  [ -n "$TGWS_SECRET" ] || return 0
  procd_open_instance
  if [ -n "$TGWS_LINK_IP" ]; then
    procd_set_param command "$BIN" --port "$TGWS_PORT" --secret "$TGWS_SECRET" --link-ip "$TGWS_LINK_IP"
  else
    procd_set_param command "$BIN" --port "$TGWS_PORT" --secret "$TGWS_SECRET"
  fi
  procd_set_param respawn 3600 5 5
  procd_close_instance
}
