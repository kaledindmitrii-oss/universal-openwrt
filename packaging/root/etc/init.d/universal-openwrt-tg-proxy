#!/bin/sh /etc/rc.common
START=96
STOP=09
USE_PROCD=1
NAME=universal-openwrt-tg-proxy
CONF=/etc/sing-box/telegram-socks5.json

start_service(){
  [ -s "$CONF" ] || return 0
  SB="$(command -v sing-box 2>/dev/null || true)"
  [ -n "$SB" ] || return 0
  "$SB" check -c "$CONF" >/dev/null 2>&1 || return 0
  procd_open_instance
  procd_set_param command "$SB" run -c "$CONF"
  procd_set_param respawn 3600 5 5
  procd_close_instance
}
