# Keep source files stable across Windows/Linux environments.

* text=auto
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.lst text eol=lf
*.tsv text eol=lf
*.js text eol=lf
*.py text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

*.ipk binary
*.apk binary
*.zip binary
*.gz binary
*.tar binary
